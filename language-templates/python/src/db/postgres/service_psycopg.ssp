<%@ val ctx: com.jacoby6000.smithy.stache.sql.codegen.ServiceTemplateView %>
<%@ val imports: com.jacoby6000.smithy.stache.sql.codegen.ImportRequirements = importRequirements(ctx) %>
from __future__ import annotations

from typing import override

<% render("fragments/helpers/imports_postgres", Map("ctx" -> ctx)) +%>import psycopg
from psycopg_transaction_run import run
<% render("fragments/helpers/model_imports", Map("ctx" -> ctx)) %>
from ${serviceModuleBaseName(ctx.serviceName)}_protocol import ${serviceProtocolName(ctx.serviceName)}


class ${implementationClassName(ctx.serviceName, ctx.dialectKey)}(${serviceProtocolName(ctx.serviceName)}[${transactionTypeName(ctx.dialectKey)}]):
    def __init__(self, connection: psycopg.AsyncConnection) -> None:
        super().__init__()
        self._connection = connection
<% if (imports.needsUuidTextLoader) { %>
        connection.adapters.register_loader("uuid", TextLoader)
<% } %>

<% for (operation <- ctx.operations) { %><% if (operation.hasSql) { %>
    @override
    async def ${operationMethodName(operation.name)}(
        self,
<% for (parameter <- operation.parameters) { %>
        ${parameter.name}: <% render("fragments/types/parameter_annotation", Map("typeName" -> parameter.typeName, "optional" -> parameter.optional)) %>,
<% } %>
<% render("fragments/types/transaction_parameter_impl", Map("dialectKey" -> ctx.dialectKey)) %><%= "\n" %>    ) -> <% render("fragments/types/response_type", Map("operation" -> operation)) +%>:
        async def execute() -> <% render("fragments/types/response_type", Map("operation" -> operation)) +%>:
<% render("fragments/operations/postgres_operation_body", Map("operation" -> operation)) +%>        return await run(self._connection, transaction, execute)
<% } %><% } %>
<% include("fragments/helpers/row_reader_helpers") +%>
