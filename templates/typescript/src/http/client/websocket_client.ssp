<%@ val ctx: com.jacoby6000.smithplates.http.service.renderer.HttpNeutralServiceTemplateAttributes.ServiceView %>
<% val S = com.jacoby6000.smithplates.http.service.renderer.HttpNeutralServiceTemplateAttributes %>
<%
val wsOps = S.websocketOperations(ctx)
val inputImports = wsOps.filter(S.websocketHasInputMessages).flatMap { operation =>
  for {
    inType <- S.websocketInputTypeName(ctx, operation)
    inModule <- S.websocketInputModule(ctx, operation)
    serialize <- S.websocketInputSerializeFunction(ctx, operation)
  } yield (inType, inModule, serialize)
}.distinct
val outputImports = wsOps.flatMap { operation =>
  for {
    outType <- S.websocketOutputTypeName(ctx, operation)
    outModule <- S.websocketOutputModule(ctx, operation)
    parse <- S.websocketOutputParseFunction(ctx, operation)
  } yield (outType, outModule, parse)
}.distinct
val hasPathLabels = wsOps.exists(operation => S.websocketPathLabels(operation).nonEmpty)
val memberMessageOps = wsOps.filter(S.websocketUsesMemberMessage)
%>
// Generated by smithplates HTTP codegen. Do not edit.

<% for ((inType, inModule, serialize) <- inputImports) { %>
import type { ${inType} } from "${inModule}";
import { ${serialize} } from "${inModule}";
<% } %>
<% for ((outType, outModule, parse) <- outputImports) { %>
import type { ${outType} } from "${outModule}";
import { ${parse} } from "${outModule}";
<% } %>
<% for ((typeName, module) <- memberMessageOps.flatMap(operation => S.websocketMemberModelImports(ctx, operation)).distinct) { %>
import type { ${typeName} } from "${module}";
<% } %>
<% if (hasPathLabels) { %>

function encodeRfc3986(value: string): string {
  return encodeURIComponent(value).replace(
    /[!'()*]/g,
    (character) => "%" + character.charCodeAt(0).toString(16).toUpperCase(),
  );
}
<% } %>
<% for (operation <- memberMessageOps) { %>

export interface ${S.websocketMemberMessageTypeName(ctx, operation)} {
<% for (member <- S.websocketBodyMembers(operation)) { %>
  ${S.websocketMemberName(ctx, member)}${if (member.required) "" else "?"}: ${S.websocketMemberTypeAnnotation(ctx, member)}${if (member.required) "" else " | null"};
<% } %>
}
<% } %>

export class ${S.serviceName(ctx)}WebsocketClient {
  private readonly baseUrl: string;

  constructor(baseUrl: string) {
    this.baseUrl = baseUrl.replace(/\/+$/, "");
  }
<% for (operation <- wsOps) { %>
<% val path = S.websocketPath(operation) %>
<% val pathLabels = S.websocketPathLabels(operation) %>
<% val connection = S.websocketConnectionName(ctx, operation) %>
<% val methodName = S.operationMethodName(ctx, operation.id.name) %>
<% val interpolatedPath = pathLabels.foldLeft(path) { case (current, member) =>
     val parameter = S.websocketPathLabelName(ctx, member)
     val encoded = "encodeRfc3986(String(" + parameter + "))"
     val greedy = "String(" + parameter + ").split(\"/\").map(encodeRfc3986).join(\"/\")"
     current
       .replace("{" + member.name + "+}", "$" + "{" + greedy + "}")
       .replace("{" + member.name + "}", "$" + "{" + encoded + "}")
   } %>
<% val urlExpr = "`${this.baseUrl}" + interpolatedPath + "`" %>

  connect${methodName.capitalize}(<% for ((label, index) <- pathLabels.zipWithIndex) { %><% if (index > 0) { %>, <% } %>${S.websocketPathLabelName(ctx, label)}: string<% } %>): ${connection} {
    const socket = new WebSocket(${urlExpr});
    return new ${connection}(socket);
  }
<% } %>
}
<% for (operation <- wsOps) { %>
<% val inType = S.websocketInputTypeName(ctx, operation) %>
<% val hasInput = S.websocketHasInputMessages(operation) %>
<% val outType = S.websocketOutputTypeName(ctx, operation) %>
<% val serializeInput = S.websocketInputSerializeFunction(ctx, operation) %>
<% val parseOutput = S.websocketOutputParseFunction(ctx, operation) %>

export class ${S.websocketConnectionName(ctx, operation)} {
  private readonly socket: WebSocket;

  constructor(socket: WebSocket) {
    this.socket = socket;
  }
<% if (hasInput && inType.isDefined) { %>

  send(message: ${inType.get}): void {
<% if (serializeInput.isDefined) { %>
    this.socket.send(JSON.stringify(${serializeInput.get}(message)));
<% } else { %>
    this.socket.send(JSON.stringify(message));
<% } %>
  }
<% } %>
<% if (outType.isDefined) { %>

  onMessage(handler: (message: ${outType.get}) => void): () => void {
    const listener = (event: MessageEvent) => {
      const data =
        typeof event.data === "string"
          ? event.data
          : new TextDecoder().decode(event.data);
      handler(${parseOutput.get}(JSON.parse(data)));
    };
    this.socket.addEventListener("message", listener);
    return () => this.socket.removeEventListener("message", listener);
  }
<% } %>

  onClose(handler: (event: { code: number; reason: string; wasClean: boolean }) => void): () => void {
    this.socket.addEventListener("close", handler);
    return () => this.socket.removeEventListener("close", handler);
  }

  close(): void {
    this.socket.close();
  }
}
<% } %>
