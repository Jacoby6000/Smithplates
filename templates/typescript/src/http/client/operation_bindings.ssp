<%@ val ctx: com.jacoby6000.smithplates.http.service.renderer.HttpNeutralServiceTemplateAttributes.ServiceView %>
<% val H = com.jacoby6000.smithplates.http.service.renderer.HttpNeutralServiceTemplateAttributes %>
// Generated by smithplates HTTP codegen. Do not edit.
<% if (H.serviceConfiguresAuth(ctx)) { %>

export interface AuthCredential {
  schemeId: string;
  value: string;
}

export interface AuthProvider {
  resolveAuth(schemeId: string): AuthCredential | null | undefined;
}

export interface AuthSchemeBinding {
  schemeId: string;
  location: "header" | "query" | "cookie";
  name: string;
  prefix: string | null;
}

export interface OperationAuthBinding {
  alternatives: string[];
  allowsAnonymous: boolean;
}

export const AUTH_SCHEME_BINDINGS: Record<string, AuthSchemeBinding> = {
<% for (scheme <- H.serviceAuthSchemes(ctx)) { %>
  ${tsStringLiteral(H.authSchemeId(scheme))}: {
    schemeId: ${tsStringLiteral(H.authSchemeId(scheme))},
    location: ${tsStringLiteral(H.authSchemeLocation(scheme))},
    name: ${tsStringLiteral(H.authSchemeName(scheme))},
    prefix: <% H.authSchemePrefix(scheme) match { case Some(prefix) => %>${tsStringLiteral(prefix)}<% case None => %>null<% } %>,
  },
<% } %>
};

export const OPERATION_AUTH_BINDINGS: Record<string, OperationAuthBinding> = {
<% for (operation <- H.restOperations(ctx)) { %>
<% for (bindingKey <- H.operationBindingKeys(ctx, operation)) { %>
  ${tsStringLiteral(bindingKey)}: {
    alternatives: [
<% for (alternative <- H.operationAuthAlternatives(operation)) { %>
      ${tsStringLiteral(H.modelIdValue(alternative.schemeId))},
<% } %>
    ],
    allowsAnonymous: ${H.operationAllowsAnonymous(operation)},
  },
<% } %>
<% } %>
};

function encodeRfc3986(value: string): string {
  return encodeURIComponent(value).replace(
    /[!'()*]/g,
    (character) => "%" + character.charCodeAt(0).toString(16).toUpperCase(),
  );
}

function setHeader(headers: Record<string, string>, name: string, value: string): void {
  const existingKey = Object.keys(headers).find((key) => key.toLowerCase() === name.toLowerCase());
  if (existingKey !== undefined && existingKey !== name) {
    delete headers[existingKey];
  }
  headers[name] = value;
}

export function applyOperationAuth(
  binding: OperationAuthBinding,
  authProvider: AuthProvider | undefined,
  headers: Record<string, string>,
  queryParts: string[],
): void {
  let browserCookieAvailable = false;
  const allowedSchemeIds = new Set(
    binding.alternatives.filter((schemeId) => schemeId !== "smithy.api#noAuth"),
  );
  for (const schemeId of binding.alternatives) {
    if (schemeId === "smithy.api#noAuth") {
      return;
    }

    const scheme = AUTH_SCHEME_BINDINGS[schemeId];
    if (scheme === undefined) {
      throw new Error("No auth binding registered for scheme " + schemeId);
    }
    if (scheme.location === "cookie") {
      browserCookieAvailable = true;
      continue;
    }
    if (authProvider === undefined) {
      continue;
    }

    const credential = authProvider.resolveAuth(schemeId);
    if (credential === null || credential === undefined) {
      continue;
    }
    if (!allowedSchemeIds.has(credential.schemeId)) {
      throw new Error(
        "Auth provider returned scheme " + credential.schemeId + ", which is not allowed by the operation",
      );
    }
    if (credential.schemeId !== schemeId) {
      throw new Error(
        "Auth provider returned scheme " + credential.schemeId + " while resolving " + schemeId,
      );
    }
    if (credential.value.length === 0) {
      continue;
    }

    const value = scheme.prefix === null ? credential.value : scheme.prefix + " " + credential.value;
    if (scheme.location === "header") {
      setHeader(headers, scheme.name, value);
    } else if (scheme.location === "query") {
      queryParts.push(encodeRfc3986(scheme.name) + "=" + encodeRfc3986(value));
    }
    return;
  }

  if (browserCookieAvailable) {
    return;
  }
  if (!binding.allowsAnonymous) {
    throw new Error("No usable authentication credential is available for the operation");
  }
}
<% } %>

export interface ResponseVariantBinding {
  statusCode: number;
  mediaType: string | null;
  headerBindings: Array<[string, string]>;
  staticHeaders: Array<[string, string]>;
}

export interface ClientOperationHttpBinding {
  variantsByTypeName: Record<string, ResponseVariantBinding>;
  variantsByStatus: Record<number, string>;
}

/** Look up the response variant registered for a given HTTP status code. */
export function variantForStatus(
  binding: ClientOperationHttpBinding,
  statusCode: number,
): ResponseVariantBinding {
  const typeName = binding.variantsByStatus[statusCode];
  if (typeName === undefined) {
    throw new Error("No HTTP binding registered for response status " + statusCode);
  }
  const variant = binding.variantsByTypeName[typeName];
  if (variant === undefined) {
    throw new Error("No HTTP binding registered for response type " + typeName);
  }
  return variant;
}

/** Look up the response model type name registered for a given HTTP status code. */
export function typeNameForStatus(
  binding: ClientOperationHttpBinding,
  statusCode: number,
): string {
  const typeName = binding.variantsByStatus[statusCode];
  if (typeName === undefined) {
    throw new Error("No HTTP binding registered for response status " + statusCode);
  }
  return typeName;
}

export const OPERATION_HTTP_BINDINGS: Record<string, ClientOperationHttpBinding> = {
<% for (operation <- H.operations(ctx)) { %>
<% for (bindingKey <- H.operationBindingKeys(ctx, operation)) { %>
  ${tsStringLiteral(bindingKey)}: {
    variantsByTypeName: {
<% for (variant <- H.clientResponseVariants(ctx, operation)) { %>
      ${tsStringLiteral(variant.variantTypeName)}: {
        statusCode: ${variant.statusCode},
        mediaType: ${tsMediaType(variant.mediaType)},
        headerBindings: ${tsTupleOfPairs(variant.headerBindings)},
        staticHeaders: ${tsTupleOfPairs(variant.staticHeaders)},
      },
<% } %>
    },
    variantsByStatus: {
<% for (variant <- H.clientResponseVariants(ctx, operation)) { %>
      ${variant.statusCode}: ${tsStringLiteral(variant.variantTypeName)},
<% } %>
    },
  },
<% } %>
<% } %>
};
