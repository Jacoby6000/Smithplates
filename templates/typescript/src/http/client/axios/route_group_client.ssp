<%@ val ctx: com.jacoby6000.smithplates.http.service.renderer.HttpNeutralRouteGroupTemplateAttributes.RouteGroupView %>
<%
val R = com.jacoby6000.smithplates.http.service.renderer.HttpNeutralRouteGroupTemplateAttributes
import com.jacoby6000.smithplates.codegen.core.OperationModel
import com.jacoby6000.smithplates.http.codegen.HttpInputMemberBindingMeta
import com.jacoby6000.smithplates.http.codegen.HttpOperationBodyBindingMeta
import com.jacoby6000.smithplates.http.codegen.HttpOperationMeta
import com.jacoby6000.smithplates.http.HttpSmithyTypeResolver

val operations = R.operations(ctx)
val pkg = tsImportPath(R.packageName(ctx))
%>
// Generated by smithplates HTTP codegen. Do not edit.

import axios, { type AxiosInstance } from "axios";
import { dumpApiModel } from "${pkg}/modelValidation";
import { parseClientResponse } from "${pkg}/client/clientResponse";
import { OPERATION_HTTP_BINDINGS } from "${pkg}/client/operationBindings";
<% for (typeName <- operations.flatMap(operation => R.operationImportedModelNames(ctx, operation)).distinct.sorted) { %>
import type { ${typeName} } from "${R.modelTypeImportModule(ctx, typeName)}";
<% } %>

export class ${R.clientClassName(R.tag(ctx))} {
  private readonly baseUrl: string;
  private readonly axiosInstance: AxiosInstance;

  constructor(baseUrl: string, axiosInstance: AxiosInstance = axios) {
    this.baseUrl = baseUrl.replace(/\/+$/, "");
    this.axiosInstance = axiosInstance;
  }
<% for (operation <- operations) { %>
<% val feature = operation.meta.feature %>
<% val methodName = R.operationMethodName(ctx, operation.id.name) %>
<%
def tsReturnType(op: OperationModel[HttpOperationMeta]): String = {
  val f = op.meta.feature
  val hasEmptySuccess = f.responseVariants.exists(v => v.statusCode == f.successStatus && v.variantTypeName == "__empty__")
  val types = f.responseVariants.map(_.variantTypeName).filterNot(_ == "__empty__").distinct
  val allTypes = if (hasEmptySuccess) types :+ "void" else types
  if (allTypes.isEmpty) "void" else allTypes.mkString(" | ")
}
def tsUrl(op: OperationModel[HttpOperationMeta]): String = {
  val pathMembers = op.meta.feature.inputMembers.filter(_.binding == HttpInputMemberBindingMeta.PathLabel)
  val interpolated = pathMembers.foldLeft(op.meta.feature.uriPattern) { case (uri, member) =>
    val paramName = R.routeParameterName(ctx, member.name)
    val replacement = "$" + "{" + paramName + "}"
    uri.replace("{" + member.name + "}", replacement)
  }
  "`${this.baseUrl}" + interpolated + "`"
}
def headerName(member: com.jacoby6000.smithplates.http.codegen.HttpOperationInputMemberMeta): String =
  member.binding match {
    case HttpInputMemberBindingMeta.Header(name) => name
    case _                                        => member.name
  }
def tsDataExpr(op: OperationModel[HttpOperationMeta]): Option[String] =
  op.meta.feature.bodyBinding match {
    case HttpOperationBodyBindingMeta.None                     => None
    case HttpOperationBodyBindingMeta.Document(inputShapeName) =>
      val paramName = R.routeParameterName(ctx, inputShapeName)
      Some(s"dumpApiModel($paramName)")
    case HttpOperationBodyBindingMeta.Members(members)         =>
      if (members.size == 1) {
        val m = members.head
        val paramName = R.routeParameterName(ctx, m.name)
        if (HttpSmithyTypeResolver.isStructureTypeName(m.typeName)) {
          Some(s"dumpApiModel($paramName)")
        } else {
          Some(paramName)
        }
      } else {
        val entries = members.map { m =>
          val paramName = R.routeParameterName(ctx, m.name)
          val serialized =
            if (HttpSmithyTypeResolver.isStructureTypeName(m.typeName)) s"dumpApiModel($paramName)"
            else paramName
          s"${tsStringLiteral(m.name)}: $serialized"
        }.mkString(", ")
        Some(s"{ $entries }")
      }
  }
def tsParams(op: OperationModel[HttpOperationMeta]): List[String] = {
  val f = op.meta.feature
  val routeParams =
    f.inputMembers.filter(R.isRouteParameter).map { member =>
      val paramName = R.routeParameterName(ctx, member.name)
      val paramType = R.httpMemberTypeAnnotation(ctx, member, member.required).replace("None", "null")
      s"$paramName: $paramType"
    }
  val bodyParams = f.bodyBinding match {
    case HttpOperationBodyBindingMeta.Document(inputShapeName) =>
      List(s"${R.routeParameterName(ctx, inputShapeName)}: $inputShapeName")
    case HttpOperationBodyBindingMeta.Members(members)         =>
      members.map { member =>
        val paramName = R.routeParameterName(ctx, member.name)
        val paramType = R.httpMemberTypeAnnotation(ctx, member, member.required).replace("None", "null")
        s"$paramName: $paramType"
      }
    case HttpOperationBodyBindingMeta.None                     =>
      Nil
  }
  routeParams ++ bodyParams
}
val dataExpr = tsDataExpr(operation)
val returnType = tsReturnType(operation)
val headerMembers = feature.inputMembers.filter(_.binding.isInstanceOf[HttpInputMemberBindingMeta.Header])
val params = tsParams(operation)
%>

  async ${methodName}(
<% for (param <- params) { %>
    ${param},
<% } %>
  ): Promise<${returnType}> {
    const headers: Record<string, string> = {};
<% for (member <- headerMembers) { %>
<% val header = headerName(member) %>
<% val param = R.routeParameterName(ctx, member.name) %>
<% if (member.required) { %>
    headers[${tsStringLiteral(header)}] = String(${param});
<% } else { %>
    if (${param} !== null && ${param} !== undefined) {
      headers[${tsStringLiteral(header)}] = String(${param});
    }
<% } %>
<% } %>
    const response = await this.axiosInstance.request({
      method: "${feature.method.toUpperCase}",
      url: ${tsUrl(operation)},
      headers,
<% if (dataExpr.isDefined) { %>
      data: ${dataExpr.get},
<% } %>
    });
    const normalized = {
      status: response.status,
      headers: response.headers as Record<string, string>,
      text: async () =>
        typeof response.data === "string" ? response.data : JSON.stringify(response.data),
      json: async () => response.data,
    };
    const parsed = await parseClientResponse(normalized, OPERATION_HTTP_BINDINGS[${tsStringLiteral(methodName)}]);
    return parsed as ${returnType};
  }
<% } %>
}
