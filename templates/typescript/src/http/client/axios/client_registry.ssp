<%@ val ctx: com.jacoby6000.smithplates.http.service.renderer.HttpNeutralServiceTemplateAttributes.ServiceView %>
<% val H = com.jacoby6000.smithplates.http.service.renderer.HttpNeutralServiceTemplateAttributes %>
// Generated by smithplates HTTP codegen. Do not edit.

import axios, { type AxiosInstance } from "axios";
<% val pkg = H.serviceModuleDir(ctx) %>
<% for (tag <- H.routeGroupTags(ctx)) { %>
import { ${H.clientClassName(tag)} } from "${pkg}/clients/${ctx.conventions.memberName(tag)}Client";
<% } %>

export interface ApiClients {
<% for (tag <- H.routeGroupTags(ctx)) { %>
  ${ctx.conventions.memberName(tag)}Client: ${H.clientClassName(tag)};
<% } %>
}

export function createApiClients(
  baseUrl: string,
  axiosInstance: AxiosInstance = axios,
): ApiClients {
  const normalizedBaseUrl = baseUrl.replace(/\/+$/, "");
  return {
<% for (tag <- H.routeGroupTags(ctx)) { %>
    ${ctx.conventions.memberName(tag)}Client: new ${H.clientClassName(tag)}(normalizedBaseUrl, axiosInstance),
<% } %>
  };
}
