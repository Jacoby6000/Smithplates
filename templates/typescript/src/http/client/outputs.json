      "binding": { "type": "service" }
    },
    {
      "id": "typescript.http.client.client_response",
      "artifactKind": "src",
      "template": "client_response.ssp",
      "outputPath": "{{smithyNamespaceDir}}/{{serviceModuleName}}/client/clientResponse.ts",
      "binding": { "type": "service" }
    },
    {
      "id": "typescript.http.client.clients_index",
      "artifactKind": "src",
