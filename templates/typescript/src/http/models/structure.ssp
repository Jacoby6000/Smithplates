<%@ val ctx: com.jacoby6000.smithplates.codegen.core.planning.TemplateView[com.jacoby6000.smithplates.codegen.core.Model.Structure[com.jacoby6000.smithplates.http.codegen.HttpMeta], com.jacoby6000.smithplates.http.codegen.HttpMeta] %>
<%
val H = com.jacoby6000.smithplates.http.service.renderer.HttpNeutralModelTemplateAttributes
val fields = H.structureFields(ctx)
val importModels = H.importModels(ctx, ctx.subject)
val className = H.className(ctx)
val extendsProblem = H.extendsProblem(ctx)
val problemBase = if (extendsProblem) s" extends ${H.httpProblemClassName}" else ""
val problemImportPath = tsImportPath(ctx.conventions.rootNamespaceDir) + "/smithplates/codegen/http/httpProblem"
%>
// Generated by smithplates HTTP codegen. Do not edit.
<% if (extendsProblem) { %>
import { ${H.httpProblemClassName} } from "${problemImportPath}";
<% } %>
<% for (model <- importModels) { %>
import { ${ctx.conventions.className(model.id)} } from "${H.modulePath(ctx, model)}";
<% } %>

export interface ${className}${problemBase} {
<% if (fields.isEmpty && !extendsProblem) { %>
  // (no fields)
<% } %>
<% for ((fieldName, literal) <- H.problemDefaultFields(ctx)) { %>
  ${fieldName}?: string | null;
<% } %>
<% for (field <- fields) { %>
  ${H.fieldName(ctx, field)}: ${H.fieldType(ctx, field)};
<% } %>
}

export function parse${className}(value: unknown): ${className} {
  return value as ${className};
}

export function serialize${className}(value: ${className}): Record<string, unknown> {
  return { ...value };
}
