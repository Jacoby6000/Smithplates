<%@ val ctx: com.jacoby6000.smithplates.codegen.core.planning.TemplateView[com.jacoby6000.smithplates.codegen.core.Model.Union[com.jacoby6000.smithplates.http.codegen.HttpMeta], com.jacoby6000.smithplates.http.codegen.HttpMeta] %>
<%
val H = com.jacoby6000.smithplates.http.service.renderer.HttpNeutralModelTemplateAttributes
val importModels = H.importModels(ctx, ctx.subject)
val className = H.className(ctx)
val variantTypeNames = ctx.subject.members.map(member => H.unionVariantTypeName(ctx, member.name))
val unionAlias = variantTypeNames.mkString(" | ")
%>
// Generated by smithplates HTTP codegen. Do not edit.
<% for (model <- importModels) { %>
<% val importAlias = H.unionImportedTypeAlias(ctx, model) %>
<% if (importAlias == ctx.conventions.className(model.id)) { %>
import { ${ctx.conventions.className(model.id)} } from "${H.modulePath(ctx, model)}";
<% } else { %>
import { ${ctx.conventions.className(model.id)} as ${importAlias} } from "${H.modulePath(ctx, model)}";
<% } %>
<% } %>

<% for (member <- ctx.subject.members) { %>
export interface ${H.unionVariantTypeName(ctx, member.name)} {
  ${H.unionFieldName(ctx, member.name)}: ${H.unionMemberType(ctx, member)};
}

<% } %>
export type ${className} = ${unionAlias};

export function parse${className}(value: unknown): ${className} {
  return value as ${className};
}

export function serialize${className}(value: ${className}): Record<string, unknown> {
  return { ...value };
}
