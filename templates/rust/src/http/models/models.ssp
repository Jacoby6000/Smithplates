<% for (field <- structure.fields) { %>
<% val wireName = field.traits.find(_.id.name == "jsonName").map(_.value).collect { case com.jacoby6000.smithplates.codegen.core.SmithyNodeValue.StringValue(value) => value }.getOrElse(field.name) %>
    #[serde(rename = ${quote(wireName)}${if (H.isOptional(field.tpe)) ", default, skip_serializing_if = \"Option::is_none\"" else ""})]
    pub ${ctx.conventions.memberName(field.name)}: ${H.renderType(field.tpe, ctx)},
<% } %>
}
<% } %>
<% for (union <- model.asUnion) { %>
#[derive(Clone, serde::Serialize, serde::Deserialize, PartialEq)]
pub enum ${ctx.conventions.className(model.id)} {
<% for (member <- union.members) { %>
<% val wireName = member.traits.find(_.id.name == "jsonName").map(_.value).collect { case com.jacoby6000.smithplates.codegen.core.SmithyNodeValue.StringValue(value) => value }.getOrElse(member.name) %>
    #[serde(rename = ${quote(wireName)})]
    ${ctx.conventions.className(com.jacoby6000.smithplates.codegen.core.ModelId("", member.name))}(${H.renderType(member.tpe, ctx)}),
<% } %>
}
<% } %>
<% for (enumModel <- model.asEnum) { %>
#[derive(Clone, serde::Serialize, serde::Deserialize, PartialEq)]
pub enum ${ctx.conventions.className(model.id)} {
<% for (value <- enumModel.values) { %>
<% val literal = value.value match { case com.jacoby6000.smithplates.codegen.core.PrimitiveLiteral.StringValue(text) => text; case other => throw new IllegalArgumentException(s"unsupported Rust enum value $other") } %>
    #[serde(rename = ${quote(literal)})]
    ${ctx.conventions.className(com.jacoby6000.smithplates.codegen.core.ModelId("", value.name))},
<% } %>
}
<% } %>
<% for (alias <- model.asAlias) { %>
pub type ${ctx.conventions.className(model.id)} = ${H.renderType(alias.underlying, ctx)};
<% } %>

<% } %>
