val H = com.jacoby6000.smithplates.http.service.renderer.HttpNeutralModelTemplateAttributes
def quote(value: String): String = "\"" + value.flatMap {
  case '"' => "\\\""
  case '\\' => "\\\\"
  case '\n' => "\\n"
  case '\r' => "\\r"
  case '\t' => "\\t"
  case c if c.isControl => "\\u{" + c.toInt.toHexString + "}"
  case c => c.toString
} + "\""
%>
// Generated by smithplates HTTP codegen. Do not edit.
<% for (model <- ctx.subject.models.sortBy(_.id.toString)) { %>
