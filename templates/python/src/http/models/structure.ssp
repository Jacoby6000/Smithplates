<%@ val structure: com.jacoby6000.smithplates.http.model.HttpStructure %>
<%@ val structureMembers: List[com.jacoby6000.smithplates.http.model.HttpStructureMember] %>
<%@ val problemBinding: Option[com.jacoby6000.smithplates.http.model.HttpProblemBinding] = None %>
<%@ val packageName: String %>
<%@ val importTypeNames: List[String] %>
<%@ val needsDatetimeImport: Boolean %>
<%@ val needsAnyImport: Boolean %>
<%
def memberNames: Set[String] = structureMembers.map(_.name).toSet

def problemDefaultFields(binding: com.jacoby6000.smithplates.http.model.HttpProblemBinding): List[(String, String, Boolean)] = {
  val typeField =
  if (!memberNames.contains("type")) {
    List(("type", pythonStringLiteral(binding.problemType), false))
  } else {
    Nil
  }
  val titleField =
    if (!memberNames.contains("title")) {
      List(("title", pythonStringLiteral(binding.title), false))
    } else {
      Nil
    }
  val detailField =
    binding.defaultDetail match {
      case Some(detail) if !memberNames.contains("detail") =>
        List(("detail", pythonStringLiteral(detail), false))
      case _                                               =>
        Nil
    }
  typeField ++ titleField ++ detailField
}
%>
# Generated by smithplates HTTP codegen. Do not edit.

from __future__ import annotations

from pydantic import BaseModel, Field
<% if (needsDatetimeImport) { %>
from datetime import datetime
<% } %>
<% if (needsAnyImport) { %>
from typing import Any
<% } %>
<% if (problemBinding.isDefined) { %>
from ${packageName}.problem import Problem
<% } %>
<% for (typeName <- importTypeNames) { %>
from ${packageName}.${snakeCase(typeName)} import ${typeName}
<% } %>


class ${structure.name}(<% if (problemBinding.isDefined) { %>Problem<% } else { %>BaseModel<% } %>):
<% if (structureMembers.isEmpty && problemBinding.isEmpty) { %>
    pass
<% } %>
<% problemBinding.foreach { binding => %>
<% for ((fieldName, literal, _) <- problemDefaultFields(binding)) { %>
    ${fieldName}: str | None = Field(default=${literal})
<% } %>
<% } %>
<% for (member <- structureMembers) { %>
<% render("fragments/models/member_field", Map("member" -> member)) %>
<% } %>
