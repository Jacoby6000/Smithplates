<%@ val ctx: com.jacoby6000.smithplates.http.service.renderer.HttpCodegenTemplateView %>
<% val routeGroup = ctx.routeGroup.get %>
<% val operations = routeGroup.operations %>
# Generated by smithplates HTTP codegen. Do not edit.

from __future__ import annotations

import httpx
from pydantic import Field  # noqa: F401
<% if (operations.flatMap(_.inputMembers).exists(m => httpMemberPythonType(m.typeName, m.timestampFormat) == "datetime")) { %>
from datetime import datetime  # noqa: F401
<% } %>

from ${ctx.packageName}.client_response import parse_client_response
from ${ctx.packageName}.operation_bindings import OPERATION_HTTP_BINDINGS
<% for (typeName <- operations.flatMap(operationImportedModelNames).distinct.sorted) { %>
from ${ctx.modelsPackageName}.${snakeCase(typeName)} import ${typeName}
<% } %>


class ${clientClassName(routeGroup.tag)}:
    def __init__(self, client: httpx.AsyncClient, base_url: str) -> None:
        self._client = client
        self._base_url = base_url.rstrip("/")

<% for (operation <- operations) { %>
    async def ${operationMethodName(operation.name)}(
        self,
<% for (parameter <- clientMethodParameters(operation)) { %>
        ${parameter},
<% } %>
    ) -> ${clientMethodReturnType(operation)}:
<% operation.documentation.foreach { doc => %>
        """${doc.linesIterator.mkString("\n        ")}"""
<% } %>
${clientRequestHeadersBlock(operation)}
        response = await self._client.request(
            "${operation.method.toUpperCase}",
            ${clientRequestUrlExpression(operation)},
            headers=headers${clientRequestJsonArgument(operation)},
        )
        return parse_client_response(
            response,
            OPERATION_HTTP_BINDINGS["${operationMethodName(operation.name)}"],
        )

<% } %>
