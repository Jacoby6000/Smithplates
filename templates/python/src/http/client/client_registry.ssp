<% } %>

<% for (tag <- H.routeGroupTags(ctx)) { %>
from ${H.servicePackageName(ctx)}.clients.${H.clientModuleName(ctx, tag)} import ${H.clientClassName(tag)}
<% } %>


@dataclass(frozen=True)
class ApiClients:
<% for (tag <- H.routeGroupTags(ctx)) { %>
    ${H.clientModuleName(ctx, tag)}: ${H.clientClassName(tag)}
<% } %>


def create_api_clients(
    client: ${httpLibrary}.AsyncClient,
    *,
    base_url: str,
<% if (H.serviceConfiguresAuth(ctx)) { %>
    auth_provider: AuthProvider | None = None,
<% } %>
) -> ApiClients:
    normalized_base_url = base_url.rstrip("/")
    return ApiClients(
<% for (tag <- H.routeGroupTags(ctx)) { %>
