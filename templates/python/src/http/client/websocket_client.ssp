<% } %>
<% for (operation <- wsOps) { %>
<% val inputType = S.websocketInputTypeName(ctx, operation).get %>
<% val outputType = S.websocketOutputTypeName(ctx, operation).get %>
<% val validateOutput = S.websocketOutputValidateFunction(ctx, operation).get %>

class ${S.websocketConnectionName(ctx, operation)}:
    def __init__(self, websocket: Any) -> None:
        self._websocket = websocket

    async def send(self, message: ${inputType}) -> None:
        await self._websocket.send(message.model_dump_json(exclude_none=True))

    async def receive(self) -> ${outputType}:
        raw = await self._websocket.recv()
        return ${validateOutput}(json.loads(raw))

    async def close(self) -> None:
        await self._websocket.close()

    async def __aenter__(self) -> Self:
        return self

    async def __aexit__(self, exc_type: object, exc: object, tb: object) -> None:
        await self.close()

    def __aiter__(self) -> Self:
