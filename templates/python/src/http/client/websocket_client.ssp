class ${S.serviceName(ctx)}WebsocketClient:
    def __init__(self, base_url: str) -> None:
        self._base_url = base_url.rstrip("/")
<% for (operation <- wsOps) { %>
<% val path = S.websocketPythonClientPath(ctx, operation) %>
<% val connection = S.websocketConnectionName(ctx, operation) %>
<% val pathLabels = S.websocketPathLabels(operation) %>

    async def connect_${S.operationMethodName(ctx, operation.id.name)}(
