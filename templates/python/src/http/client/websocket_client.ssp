<%@ val ctx: com.jacoby6000.smithplates.http.service.renderer.HttpNeutralServiceTemplateAttributes.ServiceView %>
<% val S = com.jacoby6000.smithplates.http.service.renderer.HttpNeutralServiceTemplateAttributes %>
<% val wsOps = S.websocketOperations(ctx) %>
<% val hasOutputOps = wsOps.exists(op => S.websocketOutputTypeName(ctx, op).isDefined) %>
# Generated by smithplates HTTP codegen. Do not edit.

from __future__ import annotations
<% if (wsOps.nonEmpty) { %>
<% if (hasOutputOps) { %>

import json
<% } %>
from typing import Any, Self

import websockets
<% if (hasOutputOps) { %>
from pydantic import TypeAdapter
<% } %>
<% for (operation <- wsOps) { %>
<% if (S.websocketHasInputMessages(operation)) { %>
<% S.websocketInputModule(ctx, operation).foreach { module => %>
from ${module} import ${S.websocketInputTypeName(ctx, operation).get}
<% } %>
<% } %>
<% S.websocketOutputModule(ctx, operation).foreach { module => %>
from ${module} import ${S.websocketOutputTypeName(ctx, operation).get}
<% } %>
<% } %>


class ${S.serviceName(ctx)}WebsocketClient:
    def __init__(self, base_url: str) -> None:
        self._base_url = base_url.rstrip("/")
<% for (operation <- wsOps) { %>
<% val path = S.websocketPythonPath(ctx, operation) %>
<% val connection = S.websocketConnectionName(ctx, operation) %>
<% val pathLabels = S.websocketPathLabels(operation) %>

    async def connect_${S.operationMethodName(ctx, operation.id.name)}(
        self<% for (label <- pathLabels) { %>,
        ${S.websocketPathLabelName(ctx, label)}: str<% } %>
    ) -> ${connection}:
        websocket = await websockets.connect(f"{self._base_url}${path}")
        return ${connection}(websocket)
<% } %>
<% for (operation <- wsOps) { %>
<% val inputType = S.websocketInputTypeName(ctx, operation) %>
<% val hasInput = S.websocketHasInputMessages(operation) %>
<% val outputType = S.websocketOutputTypeName(ctx, operation) %>

class ${S.websocketConnectionName(ctx, operation)}:
    def __init__(self, websocket: Any) -> None:
        self._websocket = websocket
<% if (outputType.isDefined) { %>
        self._output_adapter: TypeAdapter[${outputType.get}] = TypeAdapter(${outputType.get})
<% } %>
<% if (hasInput) { %>

    async def send(self, message: ${inputType.get}) -> None:
        await self._websocket.send(message.model_dump_json(exclude_none=True))
<% } %>
<% if (outputType.isDefined) { %>

    async def receive(self) -> ${outputType.get}:
        raw = await self._websocket.recv()
        return self._output_adapter.validate_python(json.loads(raw))
<% } %>

    async def close(self) -> None:
        await self._websocket.close()

    async def __aenter__(self) -> Self:
        return self

    async def __aexit__(self, exc_type: object, exc: object, tb: object) -> None:
        await self.close()
<% if (outputType.isDefined) { %>

    def __aiter__(self) -> Self:
        return self

    async def __anext__(self) -> ${outputType.get}:
        try:
            return await self.receive()
        except websockets.ConnectionClosed:
            raise StopAsyncIteration from None
<% } %>
<% } %>
<% } else { %>
from typing import Any


class ${S.serviceName(ctx)}WebsocketClient:
    def __init__(self, base_url: str) -> None:
        self._base_url = base_url.rstrip("/")
<% } %>
