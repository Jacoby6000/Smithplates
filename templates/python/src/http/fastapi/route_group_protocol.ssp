<%@ val ctx: com.jacoby6000.smithplates.http.service.renderer.HttpCodegenTemplateView %>
from typing import ${com.jacoby6000.smithplates.http.service.renderer.HttpCodegenFastApiAttributes.typingImports(ctx.routeGroup.get.operations).mkString(", ")}, Protocol  # noqa: F401

from pydantic import Field  # noqa: F401
