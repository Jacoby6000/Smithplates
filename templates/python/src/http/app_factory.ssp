<%@ val ctx: com.jacoby6000.smithplates.http.service.renderer.HttpCodegenTemplateView %>
# Generated by smithplates HTTP codegen. Do not edit.

from __future__ import annotations

from fastapi import FastAPI, Request
from fastapi.exceptions import RequestValidationError
from fastapi.responses import JSONResponse

from ${ctx.packageName}.api_exception_handler import FallbackApiExceptionHandler
from ${ctx.packageName}.api_exceptions import NotImplementedApiError
<% for (error <- ctx.service.serviceErrors) { %>
from ${ctx.packageName}.api_exceptions import ${serviceErrorExceptionName(error.name)}
<% } %>
from ${ctx.packageName}.app_services import ApiServices
<% for (routeGroup <- ctx.service.routeGroups) { %>
from ${ctx.packageName}.apis.${apiModuleName(routeGroup.tag)} import router as ${routerImportAlias(apiModuleName(routeGroup.tag))}
<% } %>


def configure_fallback_exception_handlers(
    app: FastAPI,
    fallback_exception_handler: FallbackApiExceptionHandler,
) -> None:
    @app.exception_handler(NotImplementedApiError)
    async def on_not_implemented(
        request: Request,
        exc: NotImplementedApiError,
    ) -> JSONResponse:
        return await fallback_exception_handler.handle_not_implemented(request, exc)
<% for (error <- ctx.service.serviceErrors) { %>

    @app.exception_handler(${serviceErrorExceptionName(error.name)})
    async def ${serviceErrorRegistrationName(error.name)}(
        request: Request,
        exc: ${serviceErrorExceptionName(error.name)},
    ) -> JSONResponse:
        return await fallback_exception_handler.${serviceErrorHandlerName(error.name)}(request, exc)
<% } %>

    @app.exception_handler(RequestValidationError)
    async def on_validation_error(
        request: Request,
        exc: RequestValidationError,
    ) -> JSONResponse:
        return await fallback_exception_handler.handle_validation_error(request, exc)

    @app.exception_handler(Exception)
    async def on_unexpected_error(request: Request, exc: Exception) -> JSONResponse:
        return await fallback_exception_handler.handle_unexpected(request, exc)


def configure_services(app: FastAPI, services: ApiServices) -> None:
    app.state.api_services = services
<% for (routeGroup <- ctx.service.routeGroups) { %>
    app.include_router(${routerImportAlias(apiModuleName(routeGroup.tag))})
<% } %>


def create_app(
    services: ApiServices,
    fallback_exception_handler: FallbackApiExceptionHandler,
) -> FastAPI:
    app = FastAPI(
        title=${pythonStringLiteral(ctx.service.title.getOrElse(ctx.service.shapeId.getName))},
        description=${pythonOptionalStringLiteral(ctx.service.documentation)},
        version=${pythonStringLiteral(ctx.service.version)},
    )
    configure_services(app, services)
    configure_fallback_exception_handlers(app, fallback_exception_handler)
    return app
