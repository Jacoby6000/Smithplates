<%
def operationMethodName(operationName: String): String =
  snakeCase(operationName)

def apiModuleName(tag: String): String =
  s"${tag}_api"

def protocolClassName(tag: String): String =
  tag
    .split("[_\\-]+")
    .filter(_.nonEmpty)
    .map(segment => s"${segment.head.toUpper}${segment.tail}")
    .mkString + "ApiServiceProtocol"

def routerImportAlias(moduleName: String): String =
  moduleName
    .split("_")
    .filter(_.nonEmpty)
    .map(segment => s"${segment.head.toUpper}${segment.tail}")
    .mkString + "Router"

def modelsPackageName(packageName: String): String =
  s"$packageName.models"

def serviceErrorExceptionName(errorName: String): String =
  s"${errorName}ApiError"

def serviceErrorHandlerName(errorName: String): String =
  s"handle_${snakeCase(errorName)}_api_error"

def serviceErrorRegistrationName(errorName: String): String =
  s"on_${snakeCase(errorName)}_api_error"

def httpMemberPythonType(
    typeName: String,
    timestampFormat: Option[com.jacoby6000.smithplates.http.model.HttpTimestampFormat]
): String =
  if (typeName == "Timestamp") {
    timestampFormat match {
      case Some(com.jacoby6000.smithplates.http.model.HttpTimestampFormat.EpochSeconds) => "float"
      case Some(com.jacoby6000.smithplates.http.model.HttpTimestampFormat.HttpDate)     => "str"
      case _                                                                              => "datetime"
    }
  } else {
    pythonTypeName(typeName)
  }

def httpMemberTypeAnnotation(
    typeName: String,
    timestampFormat: Option[com.jacoby6000.smithplates.http.model.HttpTimestampFormat],
    required: Boolean
): String =
  if (required) {
    httpMemberPythonType(typeName, timestampFormat)
  } else {
    s"${httpMemberPythonType(typeName, timestampFormat)} | None"
  }

def fastapiParameterBinding(
    member: com.jacoby6000.smithplates.http.model.HttpOperationInputMember
): String =
  member.binding match {
    case _: com.jacoby6000.smithplates.http.model.HttpInputMemberBinding.PathLabel =>
      if (member.required) {
        "Path(...)"
      } else {
        "Path(None)"
      }
    case com.jacoby6000.smithplates.http.model.HttpInputMemberBinding.Query(queryName) =>
      if (member.required) {
        s"""Query(..., alias="${queryName}")"""
      } else {
        s"""Query(None, alias="${queryName}")"""
      }
    case com.jacoby6000.smithplates.http.model.HttpInputMemberBinding.Header(headerName) =>
      if (member.required) {
        s"""Header(..., alias="${headerName}")"""
      } else {
        s"""Header(None, alias="${headerName}")"""
      }
    case _: com.jacoby6000.smithplates.http.model.HttpInputMemberBinding.Payload =>
      if (member.required) {
        "Body(...)"
      } else {
        "Body(None)"
      }
  }

def isRouteParameter(member: com.jacoby6000.smithplates.http.model.HttpOperationInputMember): Boolean =
  member.binding match {
    case _: com.jacoby6000.smithplates.http.model.HttpInputMemberBinding.Payload => false
    case _                                                                       => true
  }

def operationHasBody(operation: com.jacoby6000.smithplates.http.model.HttpOperation): Boolean =
  operation.bodyBinding match {
    case com.jacoby6000.smithplates.http.model.HttpOperationBodyBinding.None => false
    case _                                                                   => true
  }

def routeGroupHasBody(operations: List[com.jacoby6000.smithplates.http.model.HttpOperation]): Boolean =
  operations.exists(operationHasBody)

def documentBodyInputShape(
    operation: com.jacoby6000.smithplates.http.model.HttpOperation
): Option[software.amazon.smithy.model.shapes.ShapeId] =
  operation.bodyBinding match {
    case binding: com.jacoby6000.smithplates.http.model.HttpOperationBodyBinding.Document =>
      Some(binding.inputShape)
    case _ =>
      None
  }

def bodyBindingMembers(
    operation: com.jacoby6000.smithplates.http.model.HttpOperation
): List[com.jacoby6000.smithplates.http.model.HttpOperationInputMember] =
  operation.bodyBinding match {
    case binding: com.jacoby6000.smithplates.http.model.HttpOperationBodyBinding.Members =>
      binding.members
    case _ =>
      Nil
  }

def documentBodyRequired(operation: com.jacoby6000.smithplates.http.model.HttpOperation): Boolean =
  operation.inputMembers.exists(_.required)

def operationBodyModelNames(operation: com.jacoby6000.smithplates.http.model.HttpOperation): List[String] =
  operation.bodyBinding match {
    case binding: com.jacoby6000.smithplates.http.model.HttpOperationBodyBinding.Document =>
      List(binding.inputShape.getName)
    case binding: com.jacoby6000.smithplates.http.model.HttpOperationBodyBinding.Members =>
      binding.members
        .filter(member =>
          com.jacoby6000.smithplates.http.HttpSmithyTypeResolver.isStructureTypeName(member.typeName)
        )
        .map(_.typeName)
        .distinct
    case _ =>
      Nil
  }

def operationImportedModelNames(operation: com.jacoby6000.smithplates.http.model.HttpOperation): List[String] = {
  val responseType = responseTypeName(operation)
  val responseTypes =
    if (responseType == "None") {
      Nil
    } else {
      List(responseType)
    }
  (operationBodyModelNames(operation) ++ responseTypes).distinct.sorted
}

def bodyParameterBinding(required: Boolean): String =
  if (required) {
    "Body(...)"
  } else {
    "Body(None)"
  }

def operationCallArgumentList(operation: com.jacoby6000.smithplates.http.model.HttpOperation): List[String] = {
  val routeArgs =
    operation.inputMembers.filter(isRouteParameter).map(member => s"${snakeCase(member.name)}=${snakeCase(member.name)}")
  val bodyArgs = operation.bodyBinding match {
    case binding: com.jacoby6000.smithplates.http.model.HttpOperationBodyBinding.Document =>
      val paramName = snakeCase(binding.inputShape.getName)
      List(s"$paramName=$paramName")
    case binding: com.jacoby6000.smithplates.http.model.HttpOperationBodyBinding.Members =>
      binding.members.map(member => s"${snakeCase(member.name)}=${snakeCase(member.name)}")
    case _ =>
      Nil
  }
  routeArgs ++ bodyArgs
}

def operationCallArguments(operation: com.jacoby6000.smithplates.http.model.HttpOperation): String =
  operationCallArgumentList(operation).mkString(", ")

def operationServiceCallExpression(
    routeGroupTag: String,
    operation: com.jacoby6000.smithplates.http.model.HttpOperation
): String = {
  val args = operationCallArgumentList(operation)
  val target = s"services.${apiModuleName(routeGroupTag)}.${operationMethodName(operation.name)}"
  if (args.length <= 2) {
    s"await $target(${operationCallArguments(operation)})"
  } else {
    s"await $target(\n            ${args.mkString(",\n            ")},\n        )"
  }
}

def responseTypeName(operation: com.jacoby6000.smithplates.http.model.HttpOperation): String = {
  val unitShapeId = software.amazon.smithy.model.shapes.ShapeId.from("smithy.api#Unit")
  operation.outputShape.filter(_ != unitShapeId).map(_.getName).getOrElse("None")
}

def operationBindingTypeName(operation: com.jacoby6000.smithplates.http.model.HttpOperation): String = {
  val unitShapeId = software.amazon.smithy.model.shapes.ShapeId.from("smithy.api#Unit")
  operation.outputShape.filter(_ != unitShapeId).map(_.getName).getOrElse("__empty__")
}

def mediaTypeForSerialization(
    serialization: com.jacoby6000.smithplates.http.model.HttpSerialization
): String =
  serialization match {
    case com.jacoby6000.smithplates.http.model.HttpSerialization.Json => "\"application/json\""
    case _                                                              => "None"
  }

def structureMemberPythonType(
    member: com.jacoby6000.smithplates.http.model.HttpStructureMember
): String =
  httpMemberPythonType(member.typeName, member.timestampFormat)

def unionVariantTypeName(unionName: String, memberName: String): String =
  s"$unionName${memberName.capitalize}"

def unionTypeAlias(unionName: String, memberNames: Seq[String]): String =
  memberNames.map(memberName => unionVariantTypeName(unionName, memberName)).mkString(" | ")

def unionMemberPythonType(
    member: com.jacoby6000.smithplates.http.model.HttpUnionMember
): String =
  httpMemberPythonType(member.typeName, member.timestampFormat)
%>
