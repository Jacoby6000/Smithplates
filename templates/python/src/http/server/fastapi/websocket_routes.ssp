<%@ val ctx: com.jacoby6000.smithplates.http.service.renderer.HttpNeutralServiceTemplateAttributes.ServiceView %>
<% val S = com.jacoby6000.smithplates.http.service.renderer.HttpNeutralServiceTemplateAttributes %>
<% val wsOps = S.websocketOperations(ctx) %>
<% val hasInputOps = wsOps.exists(op => S.websocketHasInputMessages(op)) %>
# Generated by smithplates HTTP codegen. Do not edit.

from __future__ import annotations

<% if (hasInputOps) { %>
import json
<% } %>
from typing import Protocol

from fastapi import APIRouter, WebSocket
<% if (wsOps.nonEmpty) { %>
from fastapi import WebSocketDisconnect
<% } %>
<% if (hasInputOps) { %>
from pydantic import TypeAdapter
<% } %>
<% for (operation <- wsOps) { %>
<% if (S.websocketHasInputMessages(operation)) { %>
<% S.websocketInputModule(ctx, operation).foreach { module => %>
from ${module} import ${S.websocketInputTypeName(ctx, operation).get}
<% } %>
<% } %>
<% S.websocketOutputModule(ctx, operation).foreach { module => %>
from ${module} import ${S.websocketOutputTypeName(ctx, operation).get}
<% } %>
<% } %>


class WebsocketHandlers(Protocol):
<% if (wsOps.isEmpty) { %>
    ...
<% } else { %>
<% for (operation <- wsOps) { %>
<% val inputType = S.websocketInputTypeName(ctx, operation) %>
<% val hasInput = S.websocketHasInputMessages(operation) %>
<% val pathLabels = S.websocketPathLabels(operation) %>
    async def ${S.websocketHandlerName(ctx, operation)}(
        self,
        websocket: WebSocket,
<% for (label <- pathLabels) { %>
        ${S.websocketPathLabelName(ctx, label)}: str,
<% } %>
<% if (hasInput) { %>
        message: ${inputType.get},
<% } %>
    ) -> None:
        ...
<% } %>
<% } %>


def build_websocket_router(handlers: WebsocketHandlers) -> APIRouter:
    websocket_router = APIRouter()
<% for (operation <- wsOps) { %>
<% val path = S.websocketPythonPath(ctx, operation) %>
<% val handler = S.websocketHandlerName(ctx, operation) %>
<% val methodName = S.operationMethodName(ctx, operation.id.name) %>
<% val hasInput = S.websocketHasInputMessages(operation) %>
<% val hasOutput = S.websocketOutputTypeName(ctx, operation).isDefined %>
<% val inputType = S.websocketInputTypeName(ctx, operation) %>
<% val outputType = S.websocketOutputTypeName(ctx, operation) %>
<% val pathLabels = S.websocketPathLabels(operation) %>
<% if (hasInput) { %>

    _${methodName}_input_adapter = TypeAdapter(${inputType.get})
<% } %>
<% if (hasOutput) { %>

    async def send_${methodName}_message(
        websocket: WebSocket,
        message: ${outputType.get},
    ) -> None:
        await websocket.send_text(message.model_dump_json(exclude_none=True))
<% } %>

    @websocket_router.websocket(${pythonStringLiteral(path)})
    async def _${methodName}_websocket(
        websocket: WebSocket,
<% for (label <- pathLabels) { %>
        ${S.websocketPathLabelName(ctx, label)}: str,
<% } %>
    ) -> None:
        await websocket.accept()
<% if (hasInput) { %>
        try:
            while True:
                raw = await websocket.receive_text()
                message = _${methodName}_input_adapter.validate_python(json.loads(raw))
                await handlers.${handler}(
                    websocket,
<% for (label <- pathLabels) { %>
                    ${S.websocketPathLabelName(ctx, label)}=${S.websocketPathLabelName(ctx, label)},
<% } %>
                    message=message,
                )
        except WebSocketDisconnect:
            return
<% } else { %>
        try:
            await handlers.${handler}(
                websocket,
<% for (label <- pathLabels) { %>
                ${S.websocketPathLabelName(ctx, label)}=${S.websocketPathLabelName(ctx, label)},
<% } %>
            )
        except WebSocketDisconnect:
            return
<% } %>
<% } %>
    return websocket_router
