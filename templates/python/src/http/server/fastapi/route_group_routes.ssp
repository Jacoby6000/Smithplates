<%@ val ctx: com.jacoby6000.smithplates.http.service.renderer.HttpNeutralRouteGroupTemplateAttributes.RouteGroupView %>
<% val R = com.jacoby6000.smithplates.http.service.renderer.HttpNeutralRouteGroupTemplateAttributes %>
<% val operations = R.operations(ctx) %>
<% val hasBodyBinding = R.routeGroupHasBody(ctx) %>
<% val typingSymbols = List("Annotated") %>
<% import com.jacoby6000.smithplates.http.codegen.HttpInputMemberBindingMeta %>
<%
def fastapiParameterBinding(member: com.jacoby6000.smithplates.http.codegen.HttpOperationInputMemberMeta): String =
  member.binding match {
    case HttpInputMemberBindingMeta.PathLabel =>
      val pathAlias =
        if (R.routeParameterName(ctx, member.name) == member.name) ""
        else s""", alias="${member.name}""""
      if (member.required) s"Path(...$pathAlias)"
      else s"Path(None$pathAlias)"
    case HttpInputMemberBindingMeta.Query(queryName) =>
      if (member.required) s"""Query(..., alias="$queryName")"""
      else s"""Query(None, alias="$queryName")"""
    case HttpInputMemberBindingMeta.Header(headerName) =>
      if (member.required) s"""Header(..., alias="$headerName")"""
      else s"""Header(None, alias="$headerName")"""
    case HttpInputMemberBindingMeta.Payload =>
      if (member.required) "Body(...)"
      else "Body(None)"
  }

def bodyParameterBinding(required: Boolean): String =
  if (required) "Body(...)" else "Body(None)"
%>
# Generated by smithplates HTTP codegen. Do not edit.
from typing import ${typingSymbols.mkString(", ")}  # noqa: F401

from pydantic import Field  # noqa: F401
from fastapi import (  # noqa: F401
    APIRouter,
<% if (hasBodyBinding) { %>
    Body,
<% } %>
    Depends,
<% if (R.routeGroupUsesHeaderBinding(ctx)) { %>
    Header,
<% } %>
<% if (R.routeGroupUsesPathBinding(ctx)) { %>
    Path,
<% } %>
<% if (R.routeGroupUsesQueryBinding(ctx)) { %>
    Query,
<% } %>
)
<% if (R.routeGroupNeedsDatetimeImport(ctx)) { %>
from datetime import datetime  # noqa: F401
<% } %>

from ${R.packageName(ctx)}.api_response import dispatch_api_response
from ${R.packageName(ctx)}.operation_bindings import OPERATION_HTTP_BINDINGS
from ${R.packageName(ctx)}.app_services import ApiServices, get_api_services
<% for (typeName <- operations.flatMap(operation => R.operationImportedModelNames(ctx, operation)).distinct.sorted) { %>
from ${R.modelTypeImportModule(ctx, typeName)} import ${typeName}
<% } %>

router = APIRouter()

<% for (operation <- operations) { %>
@router.${operation.meta.feature.method.toLowerCase}(
    "${operation.meta.feature.uriPattern}",
    responses={
<% val responseStatuses = operation.meta.feature.responseVariants.map(_.statusCode).distinct.sorted %>
<% for (statusCode <- responseStatuses) { %>
        ${statusCode}: {"description": "Response"},
<% } %>
    },
    response_model_by_alias=True,
)
async def ${R.operationMethodName(ctx, operation.id.name)}(
    services: Annotated[ApiServices, Depends(get_api_services)],
<% for (member <- operation.meta.feature.inputMembers.filter(R.isRouteParameter)) { %>
    ${R.memberName(ctx, member.name)}: ${R.httpMemberTypeAnnotation(ctx, member, member.required)} = ${fastapiParameterBinding(member)},
<% } %>
<% R.documentBodyInputShape(operation).foreach { inputShape => %>
    ${R.memberName(ctx, inputShape)}: ${inputShape} = ${bodyParameterBinding(R.documentBodyRequired(operation))},
<% } %>
<% for (member <- R.bodyBindingMembers(operation)) { %>
    ${R.memberName(ctx, member.name)}: ${R.httpMemberTypeAnnotation(ctx, member, member.required)} = ${fastapiParameterBinding(member)},
<% } %>
) -> ${R.responseTypeName(operation)}:
    return dispatch_api_response(
        ${R.operationServiceCallExpression(ctx, operation)},
        OPERATION_HTTP_BINDINGS["${R.operationMethodName(ctx, operation.id.name)}"],
    )
<% } %>
