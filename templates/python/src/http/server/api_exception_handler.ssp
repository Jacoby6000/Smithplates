<%@ val ctx: com.jacoby6000.smithplates.http.service.renderer.HttpNeutralServiceTemplateAttributes.ServiceView %>
<% val H = com.jacoby6000.smithplates.http.service.renderer.HttpNeutralServiceTemplateAttributes %>
# Generated by smithplates HTTP codegen. Do not edit.

from __future__ import annotations

import logging
import traceback
from typing import Protocol

from fastapi import Request
from fastapi.exceptions import RequestValidationError
from fastapi.responses import JSONResponse
from pydantic import BaseModel

from ${H.httpProblemImportModule(ctx)} import ${H.httpProblemClassName}
from ${H.servicePackageName(ctx)}.api_exceptions import NotImplementedApiError
<% for (error <- H.serviceErrors(ctx)) { %>
from ${H.servicePackageName(ctx)}.api_exceptions import ${H.serviceErrorExceptionName(error.name)}
<% } %>

LOGGER = logging.getLogger(__name__)


class FallbackApiExceptionHandler(Protocol):
    async def handle_not_implemented(
        self,
        request: Request,
        exc: NotImplementedApiError,
    ) -> JSONResponse: ...
<% for (error <- H.serviceErrors(ctx)) { %>

    async def ${H.serviceErrorHandlerName(ctx, error.name)}(
        self,
        request: Request,
        exc: ${H.serviceErrorExceptionName(error.name)},
    ) -> JSONResponse: ...
<% } %>

    async def handle_validation_error(
        self,
        request: Request,
        exc: RequestValidationError,
    ) -> JSONResponse: ...

    async def handle_unexpected(
        self,
        request: Request,
        exc: Exception,
    ) -> JSONResponse: ...


def problem_json_response(status_code: int, problem: ${H.httpProblemClassName}) -> JSONResponse:
    content = problem.model_dump(mode="json", exclude_none=True)
    content.setdefault("status", status_code)
    return JSONResponse(
        status_code=status_code,
        content=content,
        media_type="application/problem+json",
    )


def service_error_json_response(
    status_code: int,
    payload: BaseModel | None,
) -> JSONResponse:
    content = payload.model_dump(mode="json", exclude_none=True) if payload is not None else {}
    return JSONResponse(status_code=status_code, content=content)


class DefaultFallbackApiExceptionHandler:
    async def handle_not_implemented(
        self,
        request: Request,
        exc: NotImplementedApiError,
    ) -> JSONResponse:
        return problem_json_response(501, ${H.httpProblemClassName}(title="Not implemented", status=501))
<% for (error <- H.serviceErrors(ctx)) { %>

    async def ${H.serviceErrorHandlerName(ctx, error.name)}(
        self,
        request: Request,
        exc: ${H.serviceErrorExceptionName(error.name)},
    ) -> JSONResponse:
<% if (H.serviceErrorUsesProblem(error)) { %>
        return problem_json_response(${error.statusCode}, exc.to_problem(${error.statusCode}))
<% } else { %>
        return service_error_json_response(${error.statusCode}, exc.payload)
<% } %>
<% } %>

    async def handle_validation_error(
        self,
        request: Request,
        exc: RequestValidationError,
    ) -> JSONResponse:
        return problem_json_response(
            422,
            ${H.httpProblemClassName}(
                title="Request validation failed",
                status=422,
                detail=str(exc.errors()),
            ),
        )

    async def handle_unexpected(
        self,
        request: Request,
        exc: Exception,
    ) -> JSONResponse:
        LOGGER.error(
            "Unhandled error for %s %s",
            request.method,
            request.url.path,
            exc_info=exc,
        )
        detail = traceback.format_exc()
        return problem_json_response(
            500,
            ${H.httpProblemClassName}(
                title="Internal Server Error",
                status=500,
                detail=detail,
            ),
        )
