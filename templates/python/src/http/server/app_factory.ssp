<%@ val ctx: com.jacoby6000.smithplates.http.service.renderer.HttpNeutralServiceTemplateAttributes.ServiceView %>
<% val H = com.jacoby6000.smithplates.http.service.renderer.HttpNeutralServiceTemplateAttributes %>
# Generated by smithplates HTTP codegen. Do not edit.

from __future__ import annotations

from fastapi import FastAPI, Request
from fastapi.exceptions import RequestValidationError
from fastapi.responses import JSONResponse

from ${H.servicePackageName(ctx)}.api_exception_handler import FallbackApiExceptionHandler
from ${H.servicePackageName(ctx)}.api_exceptions import NotImplementedApiError
<% for (error <- H.serviceErrors(ctx)) { %>
from ${H.servicePackageName(ctx)}.api_exceptions import ${H.serviceErrorExceptionName(error.name)}
<% } %>
<% if (H.serviceConfiguresAuth(ctx)) { %>
from ${H.servicePackageName(ctx)}.app_services import ApiServices, AuthVerifier
<% } else { %>
from ${H.servicePackageName(ctx)}.app_services import ApiServices
<% } %>
<% for (tag <- H.routeGroupTags(ctx)) { %>
from ${H.servicePackageName(ctx)}.apis.${H.apiModuleName(tag)} import router as ${H.routerImportAlias(H.apiModuleName(tag))}
<% } %>


def configure_fallback_exception_handlers(
    app: FastAPI,
    fallback_exception_handler: FallbackApiExceptionHandler,
) -> None:
    @app.exception_handler(NotImplementedApiError)
    async def on_not_implemented(
        request: Request,
        exc: NotImplementedApiError,
    ) -> JSONResponse:
        return await fallback_exception_handler.handle_not_implemented(request, exc)
<% for (error <- H.serviceErrors(ctx)) { %>

    @app.exception_handler(${H.serviceErrorExceptionName(error.name)})
    async def ${H.serviceErrorRegistrationName(ctx, error.name)}(
        request: Request,
        exc: ${H.serviceErrorExceptionName(error.name)},
    ) -> JSONResponse:
        return await fallback_exception_handler.${H.serviceErrorHandlerName(ctx, error.name)}(request, exc)
<% } %>

    @app.exception_handler(RequestValidationError)
    async def on_validation_error(
        request: Request,
        exc: RequestValidationError,
    ) -> JSONResponse:
        return await fallback_exception_handler.handle_validation_error(request, exc)

    @app.exception_handler(Exception)
    async def on_unexpected_error(request: Request, exc: Exception) -> JSONResponse:
        return await fallback_exception_handler.handle_unexpected(request, exc)


<% if (H.serviceConfiguresAuth(ctx)) { %>
def configure_services(
    app: FastAPI,
    services: ApiServices,
    auth_verifier: AuthVerifier,
) -> None:
<% } else { %>
def configure_services(app: FastAPI, services: ApiServices) -> None:
<% } %>
    app.state.api_services = services
<% if (H.serviceConfiguresAuth(ctx)) { %>
    app.state.auth_verifier = auth_verifier
<% } %>
<% for (tag <- H.routeGroupTags(ctx)) { %>
    app.include_router(${H.routerImportAlias(H.apiModuleName(tag))})
<% } %>


def create_app(
    services: ApiServices,
    fallback_exception_handler: FallbackApiExceptionHandler,
<% if (H.serviceConfiguresAuth(ctx)) { %>
    auth_verifier: AuthVerifier,
<% } %>
) -> FastAPI:
    app = FastAPI(
        title=${pythonStringLiteral(H.serviceTitle(ctx))},
        description=${pythonOptionalStringLiteral(H.serviceDocumentation(ctx))},
        version=${pythonStringLiteral(H.serviceVersion(ctx))},
    )
<% if (H.serviceConfiguresAuth(ctx)) { %>
    configure_services(app, services, auth_verifier)
<% } else { %>
    configure_services(app, services)
<% } %>
    configure_fallback_exception_handlers(app, fallback_exception_handler)
    return app
