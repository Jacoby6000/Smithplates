<%@ val ctx: com.jacoby6000.smithplates.http.service.renderer.HttpCodegenTemplateView %>
# Generated by smithplates HTTP codegen. Do not edit.

from __future__ import annotations

from dataclasses import dataclass

from pydantic import BaseModel


@dataclass(frozen=True)
class ResponseVariantBinding:
    status_code: int
    media_type: str | None
    header_bindings: tuple[tuple[str, str], ...]
    static_headers: tuple[tuple[str, str], ...]


@dataclass(frozen=True)
class OperationHttpBinding:
    variants_by_type_name: dict[str, ResponseVariantBinding]

    def variant_for(self, response: BaseModel | None) -> ResponseVariantBinding:
        if response is None:
            binding = self.variants_by_type_name.get(
                "__empty__",
            )
            if binding is None:
                msg = "Service returned None but operation has no empty-response binding"
                raise TypeError(msg)
            return binding
        type_name = type(response).__name__
        binding = self.variants_by_type_name.get(type_name)
        if binding is None:
            msg = f"No HTTP binding registered for response type {type_name!r}"
            raise KeyError(msg)
        return binding


OPERATION_HTTP_BINDINGS: dict[str, OperationHttpBinding] = {
<% for (operation <- ctx.service.routeGroups.flatMap(_.operations)) { %>
    "${operationMethodName(operation.name)}": OperationHttpBinding(
        variants_by_type_name={
<% for (variant <- operation.responseBinding.allVariants) { %>
            "${variant.variantTypeName}": ResponseVariantBinding(
                status_code=${variant.statusCode},
                media_type=${responseVariantMediaType(variant.mediaType)},
                header_bindings=${responseVariantHeaderBindings(variant.headerBindings)},
                static_headers=${responseVariantStaticHeaders(variant.staticHeaders)},
            ),
<% } %>
        },
    ),
<% if (operationMethodName(operation.name) != operation.name) { %>
    "${operation.name}": OperationHttpBinding(
        variants_by_type_name={
<% for (variant <- operation.responseBinding.allVariants) { %>
            "${variant.variantTypeName}": ResponseVariantBinding(
                status_code=${variant.statusCode},
                media_type=${responseVariantMediaType(variant.mediaType)},
                header_bindings=${responseVariantHeaderBindings(variant.headerBindings)},
                static_headers=${responseVariantStaticHeaders(variant.staticHeaders)},
            ),
<% } %>
        },
    ),
<% } %>
<% } %>
}
