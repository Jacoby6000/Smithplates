<%@ val ctx: com.jacoby6000.smithplates.sql.service.renderer.SqlNeutralServiceTemplateAttributes.ServiceView %>
<%
val signatureTypes = sqlAttrs.operations(ctx).flatMap { operation =>
  sqlAttrs.parameters(operation).map(parameter => pythonTypeName(parameter.typeName)) :+
    pythonTypeName(sqlAttrs.outputTypeName(operation))
} ++ sqlAttrs.operationResultModels(ctx).flatMap(_.fields.map(field => sqlAttrs.renderType(ctx, field.tpe)))
def signatureUsesType(typeName: String): Boolean = signatureTypes.exists(_.split("[\\[\\], |]+").contains(typeName))
%>
from __future__ import annotations

<% if (signatureUsesType("datetime")) { %>from datetime import datetime
<% } %><% if (signatureUsesType("Decimal")) { %>from decimal import Decimal
<% } %>
<% if (sqlAttrs.operationResultModels(ctx).nonEmpty) { %>from dataclasses import dataclass
<% } %>from typing import Protocol, TypeVar

<% if (protocolTableModelImportBlock(ctx) != "") { %>${protocolTableModelImportBlock(ctx)}
<% } %><% if (enumImportBlock(ctx) != "") { %>${enumImportBlock(ctx)}<% } %><% if (sqlAttrs.operationResultModels(ctx).nonEmpty) { %>


<% render("fragments/models/dataclass_definitions", Map("models" -> sqlAttrs.operationResultModels(ctx), "ctx" -> ctx)) %><% } else if (protocolTableModelImportBlock(ctx) != "") { %>

<% } %>
T = TypeVar("T", contravariant=True)


class ${serviceProtocolName(sqlAttrs.serviceName(ctx))}(Protocol[T]):
<% for (operation <- sqlAttrs.operations(ctx)) { %>    async def ${operationMethodName(operation.id.name)}(
        self,
<% for (parameter <- sqlAttrs.parameters(operation)) { %>
        ${parameter.name}: <% render("fragments/types/parameter_annotation", Map("typeName" -> parameter.typeName, "optional" -> parameter.optional)) %>,
<% } %>
<% include("fragments/types/transaction_parameter_protocol") %>
    ) -> <% render("fragments/types/response_type", Map("operation" -> operation, "ctx" -> ctx)) +%>:
        ...
<% } %>
