<%@ val ctx: com.jacoby6000.smithplates.sql.service.renderer.ServiceTemplateView %>
<%@ val test: com.jacoby6000.smithplates.sql.service.renderer.IntegrationTestView = ctx.integrationTest.get %>
from __future__ import annotations

from collections.abc import AsyncIterator
from pathlib import Path
<% if (test.extraImports != "") { %>${test.extraImports}<% } %>

import psycopg
import pytest
import pytest_asyncio
from testcontainers.postgres import PostgresContainer
<% if (test.localImportBlock != "") { %>
${test.localImportBlock}
<% } %>
from psycopg_migrations import PsycopgMigrationService

MIGRATIONS_DIRECTORY = ${migrationsDirectoryFromTestFile(configuredMigrationsDirectory(ctx))}


@pytest_asyncio.fixture
async def ${serviceFixtureName(serviceModuleBaseName(ctx.serviceName))}(
    postgres_container: PostgresContainer,
) -> AsyncIterator[${implementationClassName(ctx.serviceName, ctx.dialectKey)}]:
    connection = await psycopg.AsyncConnection.connect(
        host=postgres_container.get_container_host_ip(),
        port=int(postgres_container.get_exposed_port(5432)),
        user=postgres_container.username,
        password=postgres_container.password,
        dbname=postgres_container.dbname,
    )
    migration_service = PsycopgMigrationService(connection, migrations_directory=MIGRATIONS_DIRECTORY)
    await migration_service.migrate_all()
    await connection.commit()
    try:
        yield ${implementationClassName(ctx.serviceName, ctx.dialectKey)}(connection)
    finally:
        await connection.close()


@pytest.mark.integration
@pytest.mark.postgres
@pytest.mark.asyncio
async def test_derived_sql_methods_lifecycle(${serviceFixtureName(serviceModuleBaseName(ctx.serviceName))}: ${implementationClassName(ctx.serviceName, ctx.dialectKey)}) -> None:
    entity_id = await ${serviceFixtureName(serviceModuleBaseName(ctx.serviceName))}.${operationMethodName(test.insertOperation.name)}(${test.insertOperation.callArguments})
    assert isinstance(entity_id, str)
    assert entity_id

    fetched = await ${serviceFixtureName(serviceModuleBaseName(ctx.serviceName))}.${operationMethodName(test.selectOneOperation.name)}(${test.selectOneOperation.callArguments})
    assert isinstance(fetched, ${test.selectOneOperation.outputShapeName})
<% if (test.selectOneOperation.hasResultAssertions) { %>
<% for (assertion <- test.selectOneOperation.resultAssertions) { %>
    ${assertion.line}
<% } %>
<% } %>
<% if (test.hasUpdateOperation) { %>
<% include("fragments/tests/update_lifecycle") %>
<% } %>
<% if (test.hasDeleteOperation) { %>
<% include("fragments/tests/delete_lifecycle") %>
<% } %>
<% include("postgres/tests/transaction_tests") %>
