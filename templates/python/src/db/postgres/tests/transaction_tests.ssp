<%@ val ctx: com.jacoby6000.smithplates.sql.service.codegen.ServiceTemplateView %>
<%@ val test: com.jacoby6000.smithplates.sql.service.codegen.IntegrationTestView = ctx.integrationTest.get %>

@pytest.mark.integration
@pytest.mark.postgres
@pytest.mark.asyncio
async def test_derived_sql_methods_transaction_commit(${serviceFixtureName(serviceModuleBaseName(ctx.serviceName))}: ${implementationClassName(ctx.serviceName, ctx.dialectKey)}) -> None:
    connection = ${serviceFixtureName(serviceModuleBaseName(ctx.serviceName))}._connection
    async with connection.transaction() as tx:
        entity_id = await ${serviceFixtureName(serviceModuleBaseName(ctx.serviceName))}.${operationMethodName(test.insertOperation.name)}(${test.insertOperation.callArguments}, transaction=tx)
        assert isinstance(entity_id, str)
        assert entity_id

        fetched = await ${serviceFixtureName(serviceModuleBaseName(ctx.serviceName))}.${operationMethodName(test.selectOneOperation.name)}(${test.selectOneOperation.callArguments}, transaction=tx)
        assert isinstance(fetched, ${test.selectOneOperation.outputShapeName})
<% for (assertion <- test.transactionCommitInTxAssertions) { %>
        ${assertion.line}
<% } %>

    fetched_after_commit = await ${serviceFixtureName(serviceModuleBaseName(ctx.serviceName))}.${operationMethodName(test.selectOneOperation.name)}(${test.selectOneOperation.callArguments})
    assert isinstance(fetched_after_commit, ${test.selectOneOperation.outputShapeName})
<% for (assertion <- test.transactionCommitAfterAssertions) { %>
    ${assertion.line}
<% } %>


@pytest.mark.integration
@pytest.mark.postgres
@pytest.mark.asyncio
async def test_derived_sql_methods_transaction_rollback(${serviceFixtureName(serviceModuleBaseName(ctx.serviceName))}: ${implementationClassName(ctx.serviceName, ctx.dialectKey)}) -> None:
    connection = ${serviceFixtureName(serviceModuleBaseName(ctx.serviceName))}._connection
    entity_id: str | None = None
    with pytest.raises(RuntimeError, match="rollback probe"):
        async with connection.transaction() as tx:
            entity_id = await ${serviceFixtureName(serviceModuleBaseName(ctx.serviceName))}.${operationMethodName(test.insertOperation.name)}(${test.insertOperation.callArguments}, transaction=tx)
            raise RuntimeError("rollback probe")

    assert entity_id is not None
    missing = await ${serviceFixtureName(serviceModuleBaseName(ctx.serviceName))}.${operationMethodName(test.selectOneOperation.name)}(${test.selectOneOperation.callArguments})
    assert missing is None
