<%@ val ctx: com.jacoby6000.smithy.stache.sql.codegen.ServiceTemplateView %>
<%@ val test: com.jacoby6000.smithy.stache.sql.codegen.IntegrationTestView = ctx.integrationTest.get %>

    updated = await ${serviceFixtureName(serviceModuleBaseName(ctx.serviceName))}.${operationMethodName(test.updateOperation.name)}(${test.updateOperation.callArguments})
    assert updated is True

    fetched_after_update = await ${serviceFixtureName(serviceModuleBaseName(ctx.serviceName))}.${operationMethodName(test.selectOneOperation.name)}(${test.selectOneOperation.callArguments})
    assert isinstance(fetched_after_update, ${test.selectOneOperation.outputShapeName})
<% if (test.selectOneOperation.hasUpdatedResultAssertions) { %>
<% for (assertion <- test.selectOneOperation.updatedResultAssertions) { %>
    ${assertion.line}
<% } %>
<% } %>
