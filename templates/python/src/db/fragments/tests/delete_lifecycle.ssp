<%@ val ctx: com.jacoby6000.smithplates.sql.service.renderer.ServiceTemplateView %>
<%@ val test: com.jacoby6000.smithplates.sql.service.renderer.IntegrationTestView = ctx.integrationTest.get %>

    deleted = await ${serviceFixtureName(ctx.serviceModuleName)}.${operationMethodName(test.deleteOperation.name)}(${test.deleteOperation.callArguments})
    assert deleted${test.deleteOperation.outputValueAccessor} is True

    missing = await ${serviceFixtureName(ctx.serviceModuleName)}.${operationMethodName(test.selectOneOperation.name)}(${test.selectOneOperation.callArguments})
    assert missing is None
