<%@ val ctx: com.jacoby6000.smithplates.sql.codegen.ServiceTemplateView %>
<%@ val test: com.jacoby6000.smithplates.sql.codegen.IntegrationTestView = ctx.integrationTest.get %>

    deleted = await ${serviceFixtureName(serviceModuleBaseName(ctx.serviceName))}.${operationMethodName(test.deleteOperation.name)}(${test.deleteOperation.callArguments})
    assert deleted is True

    missing = await ${serviceFixtureName(serviceModuleBaseName(ctx.serviceName))}.${operationMethodName(test.selectOneOperation.name)}(${test.selectOneOperation.callArguments})
    assert missing is None
