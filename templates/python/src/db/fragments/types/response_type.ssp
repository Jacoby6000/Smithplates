<%@ val operation: com.jacoby6000.smithplates.sql.service.renderer.TemplateOperationView %>
<%
def responseType(operation: com.jacoby6000.smithplates.sql.service.renderer.TemplateOperationView): String = {
  if (operation.isSelectOne) {
    if (operation.hasOutput) {
      s"${pythonTypeName(operation.outputTypeName)} | None"
    } else {
      "None"
    }
  } else {
    val responseTypes = scala.collection.mutable.ListBuffer.empty[String]
    if (operation.hasOutput) {
      responseTypes += pythonTypeName(operation.outputTypeName)
    }
    operation.errors.foreach { error =>
      responseTypes += error.name
    }
    responseTypes.toList match {
      case Nil           => "None"
      case single :: Nil => single
      case many          => many.mkString(" | ")
    }
  }
}
%>${responseType(operation)}