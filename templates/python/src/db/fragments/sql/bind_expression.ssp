<%@ val memberName: String %>
<%@ val typeName: String %>
<%@ val optional: Boolean = false %>
<%@ val isJson: Boolean = false %>
<%@ val jsonTypeName: String = "" %>
<%@ val timestampFormat: Any = null %>
<%@ val dialectKey: String %>
<% if (isJson) { %><% if (optional) { %>None if ${memberName} is None else <% } %>_json_bind_${jsonTypeName}(${memberName})<% } else if (typeName == "Timestamp" && timestampFormat != null) { %><% if (timestampFormat == "DateTime" && dialectKey == "sqlite") { %><% if (optional) { %>None if ${memberName} is None else <% } %>_timestamp_bind_datetime(${memberName})<% } else if (timestampFormat == "EpochSeconds") { %><% if (optional) { %>None if ${memberName} is None else <% } %>_timestamp_bind_epoch_seconds(${memberName})<% } else { %><% if (optional) { %>None if ${memberName} is None else <% } %>${memberName}<% } %><% } else { %><% if (optional) { %>None if ${memberName} is None else <% } %>${memberName}<% } %>