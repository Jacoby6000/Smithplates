<%@ val ctx: com.jacoby6000.smithplates.sql.service.renderer.SqlNeutralServiceTemplateAttributes.ServiceView %>
<%@ val bindParameters: List[com.jacoby6000.smithplates.sql.service.core.SqlOperationBindParameter] %>
<%@ val dialectKey: String %>
<%
  val renderedParams = bindParameters.map { bindParameter =>
    capture {
      render(
        "fragments/sql/bind_expression",
        Map(
          "memberName"      -> bindParameter.memberName,
          "typeName"        -> bindParameter.typeName,
          "optional"        -> bindParameter.optional,
          "isJson"          -> bindParameter.isJson,
          "jsonTypeName"    -> bindParameter.jsonTypeName.getOrElse(""),
          "timestampFormat" -> (if (bindParameter.timestampFormat.isEmpty) null else timestampFormatName(bindParameter.timestampFormat)),
          "dialectKey"      -> dialectKey
        )
      )
    }
  }
%>${"(" + renderedParams.mkString(", ") + (if (bindParameters.length == 1) "," else "") + ")"}
