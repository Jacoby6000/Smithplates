<%@ val bindParameters: List[com.jacoby6000.smithplates.sql.service.renderer.TemplateBindParameterView] %>
<%
  val renderedParams = bindParameters.map { bindParameter =>
    capture {
      render(
        "fragments/sql/bind_expression",
        Map(
          "memberName"      -> bindParameter.memberName,
          "typeName"        -> bindParameter.typeName,
          "optional"        -> bindParameter.optional,
          "isJson"          -> bindParameter.isJson,
          "jsonTypeName"    -> bindParameter.jsonTypeName,
          "timestampFormat" -> (if (bindParameter.timestampFormat.isEmpty) null else bindParameter.timestampFormat),
          "dialectKey"      -> bindParameter.dialectKey
        )
      )
    }
  }
%>${"(" + renderedParams.mkString(", ") + (if (bindParameters.length == 1) "," else "") + ")"}