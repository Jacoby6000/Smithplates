<%@ val typeName: String %>
<%@ val readTypeName: String = typeName %>
<%@ val optional: Boolean = false %>
<%@ val isJson: Boolean = false %>
<%@ val isEnum: Boolean = false %>
<%@ val readMode: String %>
<%@ val columnIndex: Int %>
<%@ val columnNameLiteral: String = "" %>
<%@ val rowVar: String = "row" %>
<%@ val timestampFormat: Any = null %>
<%
def rowReaderName(typeName: String, timestampFormat: Any): String =
  typeName match {
    case "String"                          => "_read_str"
    case "Integer" | "Long" | "BigInteger" => "_read_int"
    case "Float" | "Double"                => "_read_float"
    case "Boolean"                         => "_read_bool"
    case "Blob"                            => "_read_bytes"
    case "BigDecimal"                      => "_read_decimal"
    case "Timestamp" if timestampFormat == "EpochSeconds" => "_read_epoch_seconds"
    case "Timestamp"                       => "_read_datetime"
    case other                             => other
  }

def columnAccess: String =
  if (readMode == "col") {
    s"${rowVar}[${columnNameLiteral}]"
  } else {
    s"${rowVar}[${columnIndex}]"
  }

def primitiveReadExpression: String = {
  if (isJson) {
    if (readMode == "col") {
      s"_read_${typeName}_col(${rowVar}, ${columnNameLiteral})"
    } else {
      s"_read_${typeName}(${rowVar}, ${columnIndex})"
    }
  } else {
    val reader = rowReaderName(readTypeName, timestampFormat)
    if (readMode == "col") {
      s"${reader}_col(${rowVar}, ${columnNameLiteral})"
    } else {
      s"${reader}(${rowVar}, ${columnIndex})"
    }
  }
}
%><% if (optional) { %>None if ${columnAccess} is None else <% } %><% if (isEnum) { %>${typeName}(<% } %><%= primitiveReadExpression %><% if (isEnum) { %>)<% } %>
