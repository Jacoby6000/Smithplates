<%@ val ctx: com.jacoby6000.smithplates.sql.service.renderer.SqlNeutralServiceTemplateAttributes.ServiceView %>
from ${qualifiedModule(sqlAttrs.packageName(ctx), modelsModulePath(sqlAttrs.serviceModuleName(ctx)))} import (
<% for (model <- sqlAttrs.models(ctx)) { %>
    ${model.id.name},
<% } %>
<% for (union <- sqlAttrs.unions(ctx)) { %>
    ${union.id.name},
<% } %>
)
