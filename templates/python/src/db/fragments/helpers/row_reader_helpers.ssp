<%@ val ctx: com.jacoby6000.smithplates.sql.service.renderer.ServiceTemplateView %>
<% for (classRowFactory <- ctx.classRowFactories) { %>
<% render("fragments/row_factories/sqlite_class_row_factory", Map("factory" -> classRowFactory)) +%>
<% } %>
<% render("fragments/type_mapping/json_type_mappers", Map("ctx" -> ctx)) +%>
<% for (partial <- helperPartialPaths(ctx)) { %>
<% render(partial, Map("dialectKey" -> ctx.dialectKey)) +%>
<% } %>
<% for (union <- unionsUsedAsJson(ctx)) { %>
<% render("fragments/json/union_helpers", Map("union" -> union, "ctx" -> ctx, "dialectKey" -> ctx.dialectKey)) +%>
<% } %>
<% for (model <- modelsUsedAsJson(ctx)) { %>
<% render("fragments/json/structure_helpers", Map("model" -> model, "ctx" -> ctx, "dialectKey" -> ctx.dialectKey)) +%>
<% } %>
<% if (documentUsedAsJson(ctx)) { %>
<% render("fragments/json/document_helpers", Map("dialectKey" -> ctx.dialectKey)) +%>
<% } %>
<% for (partial <- helperColPartialPaths(ctx)) { %>
<% render(partial, Map("dialectKey" -> ctx.dialectKey)) +%>
<% } %>
<% for (union <- unionsUsedAsJsonCol(ctx)) { %>
<% render("fragments/json/union_helpers_col", Map("union" -> union, "ctx" -> ctx, "dialectKey" -> ctx.dialectKey)) +%>
<% } %>
<% for (model <- modelsUsedAsJsonCol(ctx)) { %>
<% render("fragments/json/structure_helpers_col", Map("model" -> model, "ctx" -> ctx, "dialectKey" -> ctx.dialectKey)) +%>
<% } %>
<% if (documentUsedAsJsonCol(ctx)) { %>
<% render("fragments/json/document_helpers_col", Map("dialectKey" -> ctx.dialectKey)) +%>
<% } %>
