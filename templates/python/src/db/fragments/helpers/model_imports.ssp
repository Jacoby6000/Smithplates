<%@ val ctx: com.jacoby6000.smithplates.sql.service.renderer.SqlNeutralServiceTemplateAttributes.ServiceView %>
<% render("fragments/helpers/table_model_imports", Map("ctx" -> ctx)) %><% if (sqlAttrs.operationResultModels(ctx).nonEmpty) { %>
from ${qualifiedModule(sqlAttrs.packageName(ctx), protocolModulePath(sqlAttrs.serviceModuleName(ctx)))} import (
<% for (model <- sqlAttrs.operationResultModels(ctx)) { %>
    ${model.id.name},
<% } %>
    ${serviceProtocolName(sqlAttrs.serviceName(ctx))},
)
<% } else { %>
from ${qualifiedModule(sqlAttrs.packageName(ctx), protocolModulePath(sqlAttrs.serviceModuleName(ctx)))} import ${serviceProtocolName(sqlAttrs.serviceName(ctx))}
<% } %>
