<%@ val model: com.jacoby6000.smithplates.sql.service.codegen.TemplateModelView %>
<%@ val dialectKey: String %>
def _read_${model.name}_col(row: dict[str, object], column: str) -> ${model.name}:
#match (dialectKey)
#case ("sqlite")    data = cast(dict[str, object], json.loads(_read_str_col(row, column)))
    return ${model.name}(
<% for (member <- model.members) { %>
        ${member.name}=cast(<% render("fragments/types/type_name", Map("typeName" -> member.typeName)) %>, data["${member.name}"]),
<% } %>    )
#case ("postgres")<% include("fragments/json/row_data_postgres_col") +%>
    return ${model.name}(
<% for (member <- model.members) { %>
        ${member.name}=cast(<% render("fragments/types/type_name", Map("typeName" -> member.typeName)) %>, data["${member.name}"]),
<% } %>    )
#end
