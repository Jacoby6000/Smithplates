<%@ val model: com.jacoby6000.smithplates.sql.service.renderer.TemplateModelView %>
<%@ val dialectKey: String %>
def _json_bind_${model.name}(value: ${model.name} | None) -> str | None:
    if value is None:
        return None
    return json.dumps(cast(object, value))


def _read_${model.name}(row: ${rowTypeName(dialectKey)}, index: int) -> ${model.name}:
#match (dialectKey)
#case ("sqlite")    data = cast(dict[str, object], json.loads(_read_str(row, index)))
    return cast(${model.name}, data)
#case ("postgres")<% include("fragments/json/row_data_postgres") +%>
    return cast(${model.name}, data)
#end
