<%@ val operation: com.jacoby6000.smithplates.sql.service.renderer.TemplateOperationView %>
#match (operation.sqlBodyKind)
#case ("insertStructureDict")<% layout("fragments/sql/postgres_cursor_wrapper", Map("rowFactoryExpr" -> "dict_row")) { %>
<% render("fragments/sql/postgres_cursor_execute", Map("operation" -> operation)) %>
                row = await cur.fetchone()
                if row is None:
                    raise RuntimeError("INSERT RETURNING produced no row")
                return ${operation.outputShapeName}(
<% for (resultField <- operation.resultFields) { %>                    <% render("fragments/sql/result_field_assignment", resultFieldAssignmentBindings(resultField, "col")) %><% } %>
                )
<% } %>
#case ("insertStructureIndex")            cur = await self._connection.execute(
<% render("fragments/sql/sql_triple_quoted_statement", Map("sqlStatement" -> operation.sqlStatement)) %>,
                <% render("fragments/sql/bind_tuple", Map("bindParameters" -> operation.bindParameters)) +%>,
            )
            row = await cur.fetchone()
            if row is None:
                raise RuntimeError("INSERT RETURNING produced no row")
            return ${operation.outputShapeName}(
<% for (resultField <- operation.resultFields) { %>                <% render("fragments/sql/result_field_assignment", resultFieldAssignmentBindings(resultField, "index")) %><% } %>
            )
#case ("booleanMutationExists")            cur = await self._connection.execute(
<% render("fragments/sql/sql_triple_quoted_statement", Map("sqlStatement" -> operation.sqlStatement)) %>,
                <% render("fragments/sql/bind_tuple", Map("bindParameters" -> operation.bindParameters)) +%>,
            )
            row = await cur.fetchone()
            return ${operation.outputShapeName}(${operation.mutationResultMemberName}=row is not None)
#case ("booleanMutationRowcount")            cur = await self._connection.execute(
<% render("fragments/sql/sql_triple_quoted_statement", Map("sqlStatement" -> operation.sqlStatement)) %>,
                <% render("fragments/sql/bind_tuple", Map("bindParameters" -> operation.bindParameters)) +%>,
            )
            return ${operation.outputShapeName}(${operation.mutationResultMemberName}=cur.rowcount > 0)
#case ("selectOneClassRow")<% layout("fragments/sql/postgres_cursor_wrapper", Map("rowFactoryExpr" -> s"class_row(${operation.outputShapeName})")) { %>
<% render("fragments/sql/postgres_cursor_execute", Map("operation" -> operation)) %>
                return await cur.fetchone()
<% } %>
#case ("selectOneDict")<% layout("fragments/sql/postgres_cursor_wrapper", Map("rowFactoryExpr" -> "dict_row")) { %>
<% render("fragments/sql/postgres_cursor_execute", Map("operation" -> operation)) %>
                row = await cur.fetchone()
                if row is None:
                    return None
                return ${operation.outputShapeName}(
<% for (resultField <- operation.resultFields) { %>                    <% render("fragments/sql/result_field_assignment", resultFieldAssignmentBindings(resultField, "col")) %><% } %>
                )
<% } %>
#case ("selectOneIndex")            cur = await self._connection.execute(
<% render("fragments/sql/sql_triple_quoted_statement", Map("sqlStatement" -> operation.sqlStatement)) %>,
                <% render("fragments/sql/bind_tuple", Map("bindParameters" -> operation.bindParameters)) +%>,
            )
            row = await cur.fetchone()
            if row is None:
                return None
            return ${operation.outputShapeName}(
<% for (resultField <- operation.resultFields) { %>                <% render("fragments/sql/result_field_assignment", resultFieldAssignmentBindings(resultField, "index")) %><% } %>
            )
#case ("selectOneJoinedFlat")            cur = await self._connection.execute(
<% render("fragments/sql/sql_triple_quoted_statement", Map("sqlStatement" -> operation.sqlStatement)) %>,
                <% render("fragments/sql/bind_tuple", Map("bindParameters" -> operation.bindParameters)) +%>,
            )
            row = await cur.fetchone()
            if row is None:
                return None
            return ${operation.outputShapeName}(
<% for (resultField <- operation.resultFields) { %>                <% render("fragments/sql/result_field_assignment", resultFieldAssignmentBindings(resultField, "index")) %><% } %>
<% for (nested <- operation.selectOneNestedBindings if !nested.isCollection) { %><% if (nested.optional) { %>                ${nested.memberName}=None if row[${nested.fields.head.columnIndex}] is None else ${nested.shapeName}(
<% for (resultField <- nested.fields) { %>                    <% render("fragments/sql/result_field_assignment", resultFieldAssignmentBindings(resultField, "index")) %><% } %>
                ),
<% } else { %>                ${nested.memberName}=${nested.shapeName}(
<% for (resultField <- nested.fields) { %>                    <% render("fragments/sql/result_field_assignment", resultFieldAssignmentBindings(resultField, "index")) %><% } %>
                ),
<% } %><% } %>            )
#case ("selectOneJoinedAggregate")            cur = await self._connection.execute(
<% render("fragments/sql/sql_triple_quoted_statement", Map("sqlStatement" -> operation.sqlStatement)) %>,
                <% render("fragments/sql/bind_tuple", Map("bindParameters" -> operation.bindParameters)) +%>,
            )
            rows = await cur.fetchall()
            if not rows:
                return None
            row = rows[0]
<% for (nested <- operation.selectOneNestedBindings if nested.isCollection) { %>            ${nested.memberName}: list[${nested.shapeName}] = []
<% } %>
<% for (nested <- operation.selectOneNestedBindings if nested.isCollection) { %>            for joined_row in rows:
                if joined_row[${nested.fields.head.columnIndex}] is not None:
                    ${nested.memberName}.append(
                        ${nested.shapeName}(
<% for (resultField <- nested.fields) { %>                            <% render("fragments/sql/result_field_assignment", resultFieldAssignmentBindings(resultField, "index", "joined_row")) %><% } %>
                        )
                    )
<% } %>
            return ${operation.outputShapeName}(
<% for (resultField <- operation.resultFields) { %>                <% render("fragments/sql/result_field_assignment", resultFieldAssignmentBindings(resultField, "index", "row")) %><% } %>
<% for (nested <- operation.selectOneNestedBindings if !nested.isCollection) { %><% if (nested.optional) { %>                ${nested.memberName}=None if row[${nested.fields.head.columnIndex}] is None else ${nested.shapeName}(
<% for (resultField <- nested.fields) { %>                    <% render("fragments/sql/result_field_assignment", resultFieldAssignmentBindings(resultField, "index", "row")) %><% } %>
                ),
<% } else { %>                ${nested.memberName}=${nested.shapeName}(
<% for (resultField <- nested.fields) { %>                    <% render("fragments/sql/result_field_assignment", resultFieldAssignmentBindings(resultField, "index", "row")) %><% } %>
                ),
<% } %><% } %>
<% for (nested <- operation.selectOneNestedBindings if nested.isCollection) { %>                ${nested.memberName}=${nested.memberName},
<% } %>            )
#end
