<%@ val operation: com.jacoby6000.smithplates.sql.service.renderer.TemplateOperationView %>
<% render("fragments/sql/sqlite_cursor_execute", Map("operation" -> operation)) +%>            row = await cursor.fetchone()
            if row is None:
                return None
            return ${operation.outputShapeName}(
<% for (resultField <- operation.resultFields) { %>                <% render("fragments/sql/result_field_assignment", resultFieldAssignmentBindings(resultField, "index")) %><% } %>
<% for (nested <- operation.selectOneNestedBindings) { %><% if (nested.isCollection) { %>                ${nested.memberName}=[],
<% } else if (nested.optional) { %>                ${nested.memberName}=None if row[${nested.fields.head.columnIndex}] is None else ${nested.shapeName}(
<% for (resultField <- nested.fields) { %>                    <% render("fragments/sql/result_field_assignment", resultFieldAssignmentBindings(resultField, "index")) %><% } %>
                ),
<% } else { %>                ${nested.memberName}=${nested.shapeName}(
<% for (resultField <- nested.fields) { %>                    <% render("fragments/sql/result_field_assignment", resultFieldAssignmentBindings(resultField, "index")) %><% } %>
                ),
<% } %><% } %>            )
