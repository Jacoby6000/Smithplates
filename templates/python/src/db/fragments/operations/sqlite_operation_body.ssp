<%@ val operation: com.jacoby6000.smithplates.codegen.core.OperationModel[com.jacoby6000.smithplates.sql.service.core.SqlOperationMeta] %>
<%@ val ctx: com.jacoby6000.smithplates.sql.service.renderer.SqlNeutralServiceTemplateAttributes.ServiceView %>
#match (sqlAttrs.sqlBodyKind(operation))
#case ("insertScalar")<% render("fragments/sql/sqlite_cursor_execute", Map("operation" -> operation, "ctx" -> ctx)) +%>            row = await cursor.fetchone()
            if row is None:
                raise RuntimeError("INSERT RETURNING produced no row")
            return _read_str(row, ${sqlAttrs.returningColumnIndex(operation).get})
#case ("insertStructureDict")<% render("fragments/sql/sqlite_cursor_execute", Map("operation" -> operation, "ctx" -> ctx)) +%>            row = await cursor.fetchone()
            if row is None:
                raise RuntimeError("INSERT RETURNING produced no row")
            <% include("fragments/sql/sqlite_named_row_mapper") +%>            return ${sqlAttrs.outputShapeName(operation)}(
<% for (resultField <- sqlAttrs.resultFields(operation)) { %>                <% render("fragments/sql/result_field_assignment", resultFieldAssignmentBindings(ctx, resultField, "col", "named_row")) %><% } %>
            )
#case ("insertStructureIndex")<% render("fragments/sql/sqlite_cursor_execute", Map("operation" -> operation, "ctx" -> ctx)) +%>            row = await cursor.fetchone()
            if row is None:
                raise RuntimeError("INSERT RETURNING produced no row")
            return ${sqlAttrs.outputShapeName(operation)}(
<% for (resultField <- sqlAttrs.resultFields(operation)) { %>                <% render("fragments/sql/result_field_assignment", resultFieldAssignmentBindings(ctx, resultField, "index")) %><% } %>
            )
#case ("booleanMutationRowcount")<% render("fragments/sql/sqlite_cursor_execute", Map("operation" -> operation, "ctx" -> ctx)) +%>            return cursor.rowcount > 0
#case ("booleanMutationExists")<% render("fragments/sql/sqlite_cursor_execute", Map("operation" -> operation, "ctx" -> ctx)) +%>            row = await cursor.fetchone()
            return row is not None
#case ("booleanStructureRowcount")<% render("fragments/sql/sqlite_cursor_execute", Map("operation" -> operation, "ctx" -> ctx)) +%>            return ${sqlAttrs.outputShapeName(operation)}(
                ${sqlAttrs.booleanResultFieldName(operation)}=cursor.rowcount > 0,
            )
#case ("booleanStructureExists")<% render("fragments/sql/sqlite_cursor_execute", Map("operation" -> operation, "ctx" -> ctx)) +%>            row = await cursor.fetchone()
            return ${sqlAttrs.outputShapeName(operation)}(
                ${sqlAttrs.booleanResultFieldName(operation)}=row is not None,
            )
#case ("selectOneClassRow")<% render("fragments/sql/sqlite_cursor_execute", Map("operation" -> operation, "ctx" -> ctx)) +%>            row = await cursor.fetchone()
            if row is None:
                return None
            return ${rowFactoryName(sqlAttrs.outputShapeName(operation))}(cursor, row)
#case ("selectOneDict")<% render("fragments/sql/sqlite_cursor_execute", Map("operation" -> operation, "ctx" -> ctx)) +%>            row = await cursor.fetchone()
            if row is None:
                return None
            <% include("fragments/sql/sqlite_named_row_mapper") +%>            return ${sqlAttrs.outputShapeName(operation)}(
<% for (resultField <- sqlAttrs.resultFields(operation)) { %>                <% render("fragments/sql/result_field_assignment", resultFieldAssignmentBindings(ctx, resultField, "col", "named_row")) %><% } %>
            )
#case ("selectOneIndex")<% render("fragments/sql/sqlite_cursor_execute", Map("operation" -> operation, "ctx" -> ctx)) +%>            row = await cursor.fetchone()
            if row is None:
                return None
            return ${sqlAttrs.outputShapeName(operation)}(
<% for (resultField <- sqlAttrs.resultFields(operation)) { %>                <% render("fragments/sql/result_field_assignment", resultFieldAssignmentBindings(ctx, resultField, "index")) %><% } %>
            )
#case ("selectOneJoinedFlat")<% include("fragments/operations/select_one_joined_flat") %>
#case ("selectOneJoinedAggregate")<% include("fragments/operations/select_one_joined_aggregate") %>
#end
