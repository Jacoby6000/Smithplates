<%@ val operation: com.jacoby6000.smithplates.sql.codegen.TemplateOperationView %>
<% render("fragments/sql/sqlite_cursor_execute", Map("operation" -> operation)) +%>            rows = await cursor.fetchall()
            if not rows:
                return None
            row = rows[0]
<% for (nested <- operation.selectOneNestedBindings if nested.isCollection) { %>            ${nested.memberName}: list[${nested.shapeName}] = []
<% } %>
<% for (nested <- operation.selectOneNestedBindings if nested.isCollection) { %>            for joined_row in rows:
                if joined_row[${nested.fields.head.columnIndex}] is not None:
                    ${nested.memberName}.append(
                        ${nested.shapeName}(
<% for (resultField <- nested.fields) { %>                            <% render("fragments/sql/result_field_assignment", resultFieldAssignmentBindings(resultField, "index", "joined_row")) %><% } %>
                        )
                    )
<% } %>
            return ${operation.outputShapeName}(
<% for (resultField <- operation.resultFields) { %>                <% render("fragments/sql/result_field_assignment", resultFieldAssignmentBindings(resultField, "index", "row")) %><% } %>
<% for (nested <- operation.selectOneNestedBindings if !nested.isCollection) { %><% if (nested.optional) { %>                ${nested.memberName}=None if row[${nested.fields.head.columnIndex}] is None else ${nested.shapeName}(
<% for (resultField <- nested.fields) { %>                    <% render("fragments/sql/result_field_assignment", resultFieldAssignmentBindings(resultField, "index", "row")) %><% } %>
                ),
<% } else { %>                ${nested.memberName}=${nested.shapeName}(
<% for (resultField <- nested.fields) { %>                    <% render("fragments/sql/result_field_assignment", resultFieldAssignmentBindings(resultField, "index", "row")) %><% } %>
                ),
<% } %><% } %>
<% for (nested <- operation.selectOneNestedBindings if nested.isCollection) { %>                ${nested.memberName}=${nested.memberName},
<% } %>            )
