<%@ val factory: com.jacoby6000.smithplates.sql.service.renderer.TemplateClassRowFactoryView %>
def ${rowFactoryName(factory.name)}(cursor: object, row: tuple[object, ...] | sqlite3.Row) -> ${factory.name}:
    return ${factory.name}(
<% for (resultField <- factory.resultFields) { %>        <% render("fragments/sql/result_field_assignment", resultFieldAssignmentBindings(resultField, "index")) %><% } %>    )
