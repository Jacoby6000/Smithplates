<%
val sqlAttrs = com.jacoby6000.smithplates.sql.service.renderer.SqlNeutralServiceTemplateAttributes

def unionVariantTypeName(unionName: String, memberName: String): String =
  s"$unionName${memberName.capitalize}"

def unionTypeAlias(unionName: String, memberNames: Seq[String]): String =
  memberNames.map(memberName => unionVariantTypeName(unionName, memberName)).mkString(" | ")

def operationMethodName(operationName: String): String =
  snakeCase(operationName)

def serviceModuleBaseName(serviceName: String): String =
  snakeCase(serviceName)

def qualifiedModule(packageName: String, relativeModulePath: String): String = {
  val suffix = relativeModulePath.stripPrefix("/").split("/").filter(_.nonEmpty).mkString(".")
  s"$packageName.$suffix"
}

def protocolModulePath(moduleBaseName: String): String =
  s"${moduleBaseName}_protocol"

def modelsModulePath(moduleBaseName: String): String =
  s"models/${moduleBaseName}_models"

def migrationServiceModulePath(dialectKey: String): String =
  dialectKey match {
    case "sqlite"   => "sqlite/sqlite_migrations"
    case "postgres" => "postgres/psycopg_migrations"
    case other      => throw new IllegalArgumentException(s"unsupported dialect key: $other")
  }

def migrationServiceClassName(dialectKey: String): String =
  dialectKey match {
    case "sqlite"   => "SqliteMigrationService"
    case "postgres" => "PsycopgMigrationService"
    case other      => throw new IllegalArgumentException(s"unsupported dialect key: $other")
  }

def serviceProtocolName(serviceName: String): String =
  s"${serviceName}ServiceProtocol"

def implementationClassName(serviceName: String, dialectKey: String): String =
  dialectKey match {
    case "sqlite"   => s"${serviceName}AiosqliteService"
    case "postgres" => s"${serviceName}PsycopgService"
    case other      => throw new IllegalArgumentException(s"unsupported dialect key: $other")
  }

def implementationModuleName(moduleBaseName: String, dialectKey: String): String =
  s"${moduleBaseName}${implementationModuleSuffix(dialectKey)}"

def implementationModuleSuffix(dialectKey: String): String =
  dialectKey match {
    case "sqlite"   => "_aiosqlite"
    case "postgres" => "_psycopg"
    case other      => throw new IllegalArgumentException(s"unsupported dialect key: $other")
  }

def rowFactoryName(className: String): String =
  s"_${className}_row_factory"

def serviceFixtureName(serviceModuleBaseName: String): String =
  s"${serviceModuleBaseName}_service"

def rowTypeName(dialectKey: String): String =
  dialectKey match {
    case "sqlite"   => "tuple[object, ...] | sqlite3.Row"
    case "postgres" => "tuple[object, ...]"
    case other      => throw new IllegalArgumentException(s"unsupported dialect key: $other")
  }

def transactionTypeName(dialectKey: String): String =
  dialectKey match {
    case "sqlite"   => "aiosqlite.Connection"
    case "postgres" => "psycopg.AsyncTransaction"
    case other      => throw new IllegalArgumentException(s"unsupported dialect key: $other")
  }

def timestampFormatName(format: Option[com.jacoby6000.smithplates.sql.model.SqlTimestampFormat]): String =
  format.map {
    case com.jacoby6000.smithplates.sql.model.SqlTimestampFormat.DateTime     => "DateTime"
    case com.jacoby6000.smithplates.sql.model.SqlTimestampFormat.EpochSeconds => "EpochSeconds"
  }.getOrElse("")

def unionDiscriminatorKeys(members: List[com.jacoby6000.smithplates.codegen.core.Variant]): String =
  sqlAttrs.unionDiscriminatorKeys(members)

def enumTypeNames(ctx: sqlAttrs.ServiceView): Set[String] =
  sqlAttrs.enumTypeNames(ctx)

def structureTypeNames(ctx: sqlAttrs.ServiceView): Set[String] =
  sqlAttrs.structureTypeNames(ctx)

def unionTypeNames(ctx: sqlAttrs.ServiceView): Set[String] =
  sqlAttrs.unionTypeNames(ctx)

def mapValueExpression(
    typeName: String,
    valueExpr: String,
    ctx: sqlAttrs.ServiceView
): String = {
  if (typeName.startsWith("List[")) {
    val inner = typeName.substring(5, typeName.length - 1)
    s"[${mapValueExpression(inner, "item", ctx)} for item in cast(list[object], $valueExpr)]"
  } else if (typeName.startsWith("Map[String, ")) {
    val inner = typeName.substring(12, typeName.length - 1)
    s"{str(key): ${mapValueExpression(inner, "mapped_value", ctx)} for key, mapped_value in cast(dict[str, object], $valueExpr).items()}"
  } else {
    typeName match {
      case "str"                             => s"str($valueExpr)"
      case "int"                             => s"int($valueExpr)"
      case "float"                           => s"float($valueExpr)"
      case "bool"                            => s"bool($valueExpr)"
      case "Decimal"                         => s"Decimal(str($valueExpr))"
      case "bytes"                           => s"bytes($valueExpr)"
      case "datetime"                        => s"_map_json_timestamp($valueExpr)"
      case "object"                          => valueExpr
      case other if structureTypeNames(ctx).contains(other) =>
        s"_map_to_$other(cast(dict[str, object], $valueExpr))"
      case other if unionTypeNames(ctx).contains(other) =>
        s"_map_to_$other(cast(dict[str, object], $valueExpr))"
      case other if enumTypeNames(ctx).contains(other) =>
        s"$other($valueExpr)"
      case other =>
        s"cast(${pythonTypeName(other)}, $valueExpr)"
    }
  }
}

def dumpValueExpression(
    typeName: String,
    valueExpr: String,
    ctx: sqlAttrs.ServiceView
): String = {
  if (typeName.startsWith("List[")) {
    val inner = typeName.substring(5, typeName.length - 1)
    s"[${dumpValueExpression(inner, "item", ctx)} for item in $valueExpr]"
  } else if (typeName.startsWith("Map[String, ")) {
    val inner = typeName.substring(12, typeName.length - 1)
    s"{key: ${dumpValueExpression(inner, "mapped_value", ctx)} for key, mapped_value in $valueExpr.items()}"
  } else {
    typeName match {
      case "datetime"                        => s"_dump_json_timestamp($valueExpr)"
      case "object"                          => valueExpr
      case other if structureTypeNames(ctx).contains(other) =>
        s"_dump_$other($valueExpr)"
      case other if unionTypeNames(ctx).contains(other) =>
        s"_dump_$other($valueExpr)"
      case other if enumTypeNames(ctx).contains(other) =>
        s"$valueExpr.value"
      case _                                 => valueExpr
    }
  }
}

def jsonMappingUsesTimestamp(ctx: sqlAttrs.ServiceView): Boolean =
  sqlAttrs.jsonMappingUsesTimestamp(ctx)

def jsonFieldAccess(memberName: String): String =
  "data[\"" + memberName + "\"]"

def helperPartialPaths(ctx: sqlAttrs.ServiceView): List[String] =
  sqlAttrs.helperPartialPaths(ctx)

def helperColPartialPaths(ctx: sqlAttrs.ServiceView): List[String] =
  sqlAttrs.helperColPartialPaths(ctx)

def unionsUsedAsJson(ctx: sqlAttrs.ServiceView): List[com.jacoby6000.smithplates.codegen.core.Model.Union[com.jacoby6000.smithplates.sql.service.core.SqlMeta]] =
  sqlAttrs.unionsUsedAsJson(ctx)

def modelsUsedAsJson(ctx: sqlAttrs.ServiceView): List[com.jacoby6000.smithplates.codegen.core.Model.Structure[com.jacoby6000.smithplates.sql.service.core.SqlMeta]] =
  sqlAttrs.modelsUsedAsJson(ctx)

def unionsUsedAsJsonCol(ctx: sqlAttrs.ServiceView): List[com.jacoby6000.smithplates.codegen.core.Model.Union[com.jacoby6000.smithplates.sql.service.core.SqlMeta]] =
  sqlAttrs.unionsUsedAsJsonCol(ctx)

def modelsUsedAsJsonCol(ctx: sqlAttrs.ServiceView): List[com.jacoby6000.smithplates.codegen.core.Model.Structure[com.jacoby6000.smithplates.sql.service.core.SqlMeta]] =
  sqlAttrs.modelsUsedAsJsonCol(ctx)

def jsonStructureClosure(ctx: sqlAttrs.ServiceView): List[com.jacoby6000.smithplates.codegen.core.Model.Structure[com.jacoby6000.smithplates.sql.service.core.SqlMeta]] =
  sqlAttrs.jsonStructureClosure(ctx)

def documentUsedAsJson(ctx: sqlAttrs.ServiceView): Boolean =
  sqlAttrs.documentUsedAsJson(ctx)

def documentUsedAsJsonCol(ctx: sqlAttrs.ServiceView): Boolean =
  sqlAttrs.documentUsedAsJsonCol(ctx)

def importRequirements(ctx: sqlAttrs.ServiceView): com.jacoby6000.smithplates.sql.service.renderer.ImportRequirements =
  sqlAttrs.importRequirements(ctx)

def resultFieldAssignmentBindings(
    ctx: sqlAttrs.ServiceView,
    resultField: com.jacoby6000.smithplates.sql.service.core.SqlOperationResultField,
    readMode: String,
    rowVar: String = "row"
): Map[String, Any] =
  Map(
    "fieldName"         -> resultField.fieldName,
    "typeName"          -> resultField.typeName,
    "readTypeName"      -> resultField.readTypeName,
    "optional"          -> resultField.optional,
    "isJson"            -> resultField.isJson,
    "isEnum"            -> sqlAttrs.enumTypeNames(ctx).contains(resultField.typeName),
    "readMode"          -> readMode,
    "columnIndex"       -> resultField.columnIndex,
    "columnNameLiteral" -> s"\"${resultField.columnName}\"",
    "rowVar"            -> rowVar,
    "timestampFormat"   -> timestampFormatName(resultField.timestampFormat)
  )

def configuredMigrationsDirectory(ctx: sqlAttrs.ServiceView): String =
  sqlAttrs.migration(ctx).map(_.migrationsDirectory).getOrElse(s"db/migrations/${sqlAttrs.dialectKey(ctx)}")

def migrationsDirectoryFromTestFile(serviceShapeId: String, migrationsDirectory: String): String = {
  val namespace = serviceShapeId.takeWhile(_ != '#')
  val namespaceDepth = namespace.split('.').toList.filter(_.nonEmpty).size
  val parentIndex = namespaceDepth + 2
  val parts = migrationsDirectory
    .stripPrefix("/")
    .stripSuffix("/")
    .stripSuffix("\\")
    .split("/")
    .filter(_.nonEmpty)
  val pathExpr = parts.map(part => s""""$part"""").mkString(" / ")
  s"Path(__file__).resolve().parents[$parentIndex] / $pathExpr"
}

def transactionRunModuleName(dialectKey: String): String =
  dialectKey match {
    case "sqlite"   => "sqlite_transaction_run"
    case "postgres" => "psycopg_transaction_run"
    case other      => throw new IllegalArgumentException(s"unsupported dialect key: $other")
  }

def referencedTypeNames(typeName: String): List[String] = {
  val listPattern = """(?i)list\[(.+)]""".r
  typeName match {
    case listPattern(inner) => List(inner.trim)
    case other              => List(other)
  }
}

def enumImportBlock(ctx: sqlAttrs.ServiceView): String = {
  val enumNames = referencedEnumTypeNames(ctx).toList.sorted
  if (enumNames.isEmpty) {
    ""
  } else {
    enumNames
      .map(enumName =>
        s"from ${qualifiedModule(sqlAttrs.packageName(ctx), snakeCase(enumName))} import $enumName")
      .mkString("\n", "\n", "\n")
  }
}

def referencedEnumTypeNames(ctx: sqlAttrs.ServiceView): Set[String] = {
  val enumNames = sqlAttrs.enumTypeNames(ctx)
  val referenced = scala.collection.mutable.LinkedHashSet.empty[String]

  def reference(typeName: String): Unit =
    referencedTypeNames(typeName).foreach { candidate =>
      if (enumNames.contains(candidate)) {
        referenced += candidate
      }
    }

  sqlAttrs.models(ctx).flatMap(_.fields).foreach(member => reference(sqlAttrs.memberTypeName(ctx, member)))
  sqlAttrs.unions(ctx).flatMap(_.members).foreach(member => reference(sqlAttrs.renderType(ctx, member.tpe)))
  sqlAttrs.operations(ctx).foreach { operation =>
    sqlAttrs.parameters(operation).foreach(parameter => reference(parameter.typeName))
    if (sqlAttrs.outputTypeName(operation).nonEmpty) reference(sqlAttrs.outputTypeName(operation))
    sqlAttrs.bindParameters(operation).foreach(bind => reference(bind.typeName))
    sqlAttrs.resultFields(operation).foreach(field => reference(field.typeName))
    sqlAttrs.selectOneNestedBindings(operation).foreach { nested =>
      reference(nested.shapeName)
      nested.fields.foreach(field => reference(field.typeName))
    }
  }

  referenced.toSet
}

def protocolReferencedNames(ctx: sqlAttrs.ServiceView): (List[String], List[String]) = {
  val tableModelNames = sqlAttrs.models(ctx).map(_.id.name).toSet
  val unionNames      = sqlAttrs.unions(ctx).map(_.id.name).toSet
  val referencedTable = scala.collection.mutable.LinkedHashSet.empty[String]
  val referencedUnion = scala.collection.mutable.LinkedHashSet.empty[String]

  def reference(typeName: String): Unit =
    referencedTypeNames(typeName).foreach { candidate =>
      if (tableModelNames.contains(candidate)) {
        referencedTable += candidate
      }
      if (unionNames.contains(candidate)) {
        referencedUnion += candidate
      }
    }

  sqlAttrs.operations(ctx).foreach { operation =>
    sqlAttrs.parameters(operation).foreach(parameter => reference(parameter.typeName))
    if (sqlAttrs.outputTypeName(operation).nonEmpty) reference(sqlAttrs.outputTypeName(operation))
  }

  sqlAttrs.operationResultModels(ctx).flatMap(_.fields).foreach(member => reference(sqlAttrs.memberTypeName(ctx, member)))

  (referencedTable.toList.sorted, referencedUnion.toList.sorted)
}

def serviceReferencedNames(ctx: sqlAttrs.ServiceView): (List[String], List[String]) = {
  val tableModelNames = sqlAttrs.models(ctx).map(_.id.name).toSet
  val unionNames      = sqlAttrs.unions(ctx).map(_.id.name).toSet
  val referencedTable = scala.collection.mutable.LinkedHashSet.empty[String]
  val referencedUnion = scala.collection.mutable.LinkedHashSet.empty[String]

  def reference(typeName: String): Unit =
    referencedTypeNames(typeName).foreach { candidate =>
      if (tableModelNames.contains(candidate)) {
        referencedTable += candidate
      }
      if (unionNames.contains(candidate)) {
        referencedUnion += candidate
        sqlAttrs.unions(ctx).find(_.id.name == candidate).foreach { union =>
          union.members.foreach { member =>
            referencedTable += unionVariantTypeName(union.id.name, member.name)
          }
        }
      }
    }

  sqlAttrs.operations(ctx).filter(op => sqlAttrs.hasSql(op)).foreach { operation =>
    sqlAttrs.parameters(operation).foreach(parameter => reference(parameter.typeName))
    if (sqlAttrs.outputTypeName(operation).nonEmpty) reference(sqlAttrs.outputTypeName(operation))
    sqlAttrs.bindParameters(operation).foreach { bindParameter =>
      reference(bindParameter.typeName)
      bindParameter.jsonTypeName.foreach(name => reference(name))
    }
    sqlAttrs.resultFields(operation).foreach(resultField => reference(resultField.typeName))
    sqlAttrs.selectOneNestedBindings(operation).foreach { nested =>
      reference(nested.shapeName)
      nested.fields.foreach(field => reference(field.typeName))
    }
  }

  val jsonClosureModels = sqlAttrs.jsonStructureClosure(ctx)
  jsonClosureModels.foreach(model => referencedTable += model.id.name)
  jsonClosureModels.foreach { model =>
    model.fields.foreach { field =>
      val typeName = sqlAttrs.memberTypeName(ctx, field)
      sqlAttrs.uuidTypeNames(ctx).foreach { uuidName =>
        if (typeName == uuidName || typeName.startsWith(s"$uuidName[") || typeName.contains(s"$uuidName")) {
          referencedTable += uuidName
        }
      }
    }
  }

  (referencedTable.toList.sorted, referencedUnion.toList.sorted)
}

def protocolTableModelImportBlock(ctx: sqlAttrs.ServiceView): String = {
  val (tableModels, unions) = protocolReferencedNames(ctx)
  val names = (tableModels ++ unions).sorted
  if (names.isEmpty) {
    ""
  } else {
    val body = names.map(name => s"    $name,").mkString("\n", "\n", "\n")
    s"from ${qualifiedModule(sqlAttrs.packageName(ctx), s"models/${sqlAttrs.serviceModuleName(ctx)}_models")} import ($body)"
  }
}

def serviceLocalImportBlock(ctx: sqlAttrs.ServiceView): String = {
  val (tableModels, unions) = serviceReferencedNames(ctx)
  val operationResultNames = sqlAttrs.operationResultModels(ctx).map(_.id.name).toSet
  val derivedResultNames = sqlAttrs.operations(ctx).filter(op => sqlAttrs.hasSql(op)).map(op => sqlAttrs.outputTypeName(op)).filter(_.nonEmpty).filter(derivedNames(ctx).contains).distinct.sorted.toList

  val blocks = List.newBuilder[String]

  val modelNames = (tableModels ++ unions).sorted
  if (modelNames.nonEmpty) {
    val body = modelNames.map(name => s"    $name,").mkString("\n", "\n", "\n")
    blocks += s"from ${qualifiedModule(sqlAttrs.packageName(ctx), s"models/${sqlAttrs.serviceModuleName(ctx)}_models")} import ($body)"
  }

  val protocolName = serviceProtocolName(sqlAttrs.serviceName(ctx))
  if (derivedResultNames.isEmpty) {
    blocks += s"from ${qualifiedModule(sqlAttrs.packageName(ctx), s"${sqlAttrs.serviceModuleName(ctx)}_protocol")} import $protocolName"
  } else {
    val body = (derivedResultNames.map(name => s"    $name,") :+ s"    $protocolName,").mkString("\n", "\n", "\n")
    blocks += s"from ${qualifiedModule(sqlAttrs.packageName(ctx), s"${sqlAttrs.serviceModuleName(ctx)}_protocol")} import ($body)"
  }

  val enumBlock = enumImportBlock(ctx)
  if (enumBlock.nonEmpty) {
    blocks += enumBlock.stripSuffix("\n")
  }

  if (sqlAttrs.operations(ctx).exists(op => sqlAttrs.hasSql(op))) {
    blocks += s"from ${qualifiedModule(sqlAttrs.packageName(ctx), s"${sqlAttrs.dialectKey(ctx)}/${transactionRunModuleName(sqlAttrs.dialectKey(ctx))}")} import run"
  }

  blocks.result().sortBy(_.linesIterator.next().stripPrefix("from ").takeWhile(_ != ' ')).mkString("\n")
}

def derivedNames(ctx: sqlAttrs.ServiceView): Set[String] =
  sqlAttrs.operationResultModels(ctx).map(_.id.name).toSet

def extractImportModuleName(block: String): String =
  block.linesIterator.next().stripPrefix("from ").takeWhile(_ != ' ')

def importBlocks(importText: String): List[String] =
  if (importText.isEmpty) {
    Nil
  } else {
    val blocks  = List.newBuilder[String]
    var current = List.newBuilder[String]
    importText.linesIterator.foreach { line =>
      if (line.startsWith("from ") && current.result().nonEmpty) {
        blocks += current.result().mkString("\n")
        current = List.newBuilder[String]
      }
      if (line.nonEmpty) {
        current += line
      }
    }
    if (current.result().nonEmpty) {
      blocks += current.result().mkString("\n")
    }
    blocks.result()
  }

def integrationTestLocalImportBlock(
    test: com.jacoby6000.smithplates.sql.service.core.SqlIntegrationTestContext,
    ctx: sqlAttrs.ServiceView
): String = {
  val implementationModule = s"${sqlAttrs.serviceModuleName(ctx)}${implementationModuleSuffix(sqlAttrs.dialectKey(ctx))}"
  val implementationClass  = implementationClassName(sqlAttrs.serviceName(ctx), sqlAttrs.dialectKey(ctx))
  val implementationBlock  =
    s"from ${qualifiedModule(sqlAttrs.packageName(ctx), s"${sqlAttrs.dialectKey(ctx)}/$implementationModule")} import $implementationClass"
  val blocks               = importBlocks(test.testImports) :+ implementationBlock
  blocks
    .groupBy(extractImportModuleName)
    .values
    .map(_.head)
    .toList
    .sortBy(extractImportModuleName)
    .mkString("\n", "\n", "")
}
%>
