<%
def unionVariantTypeName(unionName: String, memberName: String): String =
  s"$unionName${memberName.capitalize}"

def unionTypeAlias(unionName: String, memberNames: Seq[String]): String =
  memberNames.map(memberName => unionVariantTypeName(unionName, memberName)).mkString(" | ")

def operationMethodName(operationName: String): String =
  snakeCase(operationName)

def serviceModuleBaseName(serviceName: String): String =
  snakeCase(serviceName)

def qualifiedModule(packageName: String, relativeModulePath: String): String = {
  val suffix = relativeModulePath.stripPrefix("/").split("/").filter(_.nonEmpty).mkString(".")
  s"$packageName.$suffix"
}

def protocolModulePath(serviceName: String): String =
  s"${serviceModuleBaseName(serviceName)}_protocol"

def modelsModulePath(serviceName: String): String =
  s"models/${serviceModuleBaseName(serviceName)}_models"

def migrationServiceModulePath(dialectKey: String): String =
  dialectKey match {
    case "sqlite"   => "sqlite/sqlite_migrations"
    case "postgres" => "postgres/psycopg_migrations"
    case other      => throw new IllegalArgumentException(s"unsupported dialect key: $other")
  }

def migrationServiceClassName(dialectKey: String): String =
  dialectKey match {
    case "sqlite"   => "SqliteMigrationService"
    case "postgres" => "PsycopgMigrationService"
    case other      => throw new IllegalArgumentException(s"unsupported dialect key: $other")
  }

def serviceProtocolName(serviceName: String): String =
  s"${serviceName}ServiceProtocol"

def implementationClassName(serviceName: String, dialectKey: String): String =
  dialectKey match {
    case "sqlite"   => s"${serviceName}AiosqliteService"
    case "postgres" => s"${serviceName}PsycopgService"
    case other      => throw new IllegalArgumentException(s"unsupported dialect key: $other")
  }

def implementationModuleName(serviceName: String, dialectKey: String): String =
  s"${serviceModuleBaseName(serviceName)}${implementationModuleSuffix(dialectKey)}"

def implementationModuleSuffix(dialectKey: String): String =
  dialectKey match {
    case "sqlite"   => "_aiosqlite"
    case "postgres" => "_psycopg"
    case other      => throw new IllegalArgumentException(s"unsupported dialect key: $other")
  }

def rowFactoryName(className: String): String =
  s"_${className}_row_factory"

def serviceFixtureName(serviceModuleBaseName: String): String =
  s"${serviceModuleBaseName}_service"

def rowTypeName(dialectKey: String): String =
  dialectKey match {
    case "sqlite"   => "tuple[object, ...] | sqlite3.Row"
    case "postgres" => "tuple[object, ...]"
    case other      => throw new IllegalArgumentException(s"unsupported dialect key: $other")
  }

def transactionTypeName(dialectKey: String): String =
  dialectKey match {
    case "sqlite"   => "aiosqlite.Connection"
    case "postgres" => "psycopg.AsyncTransaction"
    case other      => throw new IllegalArgumentException(s"unsupported dialect key: $other")
  }

def unionDiscriminatorKeys(union: com.jacoby6000.smithplates.sql.service.renderer.TemplateUnionView): String =
  com.jacoby6000.smithplates.sql.service.renderer.SqlCodegenHelperAttributes.unionDiscriminatorKeys(union)

def helperPartialPaths(ctx: com.jacoby6000.smithplates.sql.service.renderer.ServiceTemplateView): List[String] =
  com.jacoby6000.smithplates.sql.service.renderer.SqlCodegenHelperAttributes.helperPartialPaths(ctx)

def helperColPartialPaths(ctx: com.jacoby6000.smithplates.sql.service.renderer.ServiceTemplateView): List[String] =
  com.jacoby6000.smithplates.sql.service.renderer.SqlCodegenHelperAttributes.helperColPartialPaths(ctx)

def unionsUsedAsJson(ctx: com.jacoby6000.smithplates.sql.service.renderer.ServiceTemplateView): List[com.jacoby6000.smithplates.sql.service.renderer.TemplateUnionView] =
  com.jacoby6000.smithplates.sql.service.renderer.SqlCodegenHelperAttributes.unionsUsedAsJson(ctx)

def modelsUsedAsJson(ctx: com.jacoby6000.smithplates.sql.service.renderer.ServiceTemplateView): List[com.jacoby6000.smithplates.sql.service.renderer.TemplateModelView] =
  com.jacoby6000.smithplates.sql.service.renderer.SqlCodegenHelperAttributes.modelsUsedAsJson(ctx)

def unionsUsedAsJsonCol(ctx: com.jacoby6000.smithplates.sql.service.renderer.ServiceTemplateView): List[com.jacoby6000.smithplates.sql.service.renderer.TemplateUnionView] =
  com.jacoby6000.smithplates.sql.service.renderer.SqlCodegenHelperAttributes.unionsUsedAsJsonCol(ctx)

def modelsUsedAsJsonCol(ctx: com.jacoby6000.smithplates.sql.service.renderer.ServiceTemplateView): List[com.jacoby6000.smithplates.sql.service.renderer.TemplateModelView] =
  com.jacoby6000.smithplates.sql.service.renderer.SqlCodegenHelperAttributes.modelsUsedAsJsonCol(ctx)

def documentUsedAsJson(ctx: com.jacoby6000.smithplates.sql.service.renderer.ServiceTemplateView): Boolean =
  com.jacoby6000.smithplates.sql.service.renderer.SqlCodegenHelperAttributes.documentUsedAsJson(ctx)

def documentUsedAsJsonCol(ctx: com.jacoby6000.smithplates.sql.service.renderer.ServiceTemplateView): Boolean =
  com.jacoby6000.smithplates.sql.service.renderer.SqlCodegenHelperAttributes.documentUsedAsJsonCol(ctx)

def importRequirements(ctx: com.jacoby6000.smithplates.sql.service.renderer.ServiceTemplateView): com.jacoby6000.smithplates.sql.service.renderer.ImportRequirements =
  com.jacoby6000.smithplates.sql.service.renderer.SqlCodegenHelperAttributes.importRequirements(ctx)

def resultFieldAssignmentBindings(
    resultField: com.jacoby6000.smithplates.sql.service.renderer.TemplateResultFieldView,
    readMode: String,
    rowVar: String = "row"
): Map[String, Any] =
  Map(
    "fieldName"         -> resultField.fieldName,
    "typeName"          -> resultField.typeName,
    "readTypeName"      -> resultField.readTypeName,
    "optional"          -> resultField.optional,
    "isJson"            -> resultField.isJson,
    "isEnum"            -> resultField.isEnum,
    "readMode"          -> readMode,
    "columnIndex"       -> resultField.columnIndex,
    "columnNameLiteral" -> resultField.columnNameLiteral,
    "rowVar"            -> rowVar,
    "timestampFormat"   -> resultField.timestampFormat
  )

def configuredMigrationsDirectory(ctx: com.jacoby6000.smithplates.sql.service.renderer.ServiceTemplateView): String =
  ctx.migration.map(_.migrationsDirectory).getOrElse(s"db/migrations/${ctx.dialectKey}")

def migrationsDirectoryFromTestFile(serviceShapeId: String, migrationsDirectory: String): String = {
  val namespace = serviceShapeId.takeWhile(_ != '#')
  val namespaceDepth = namespace.split('.').toList.filter(_.nonEmpty).size
  val parentIndex = namespaceDepth + 2
  val parts = migrationsDirectory
    .stripPrefix("/")
    .stripSuffix("/")
    .stripSuffix("\\")
    .split("/")
    .filter(_.nonEmpty)
  val pathExpr = parts.map(part => s""""$part"""").mkString(" / ")
  s"Path(__file__).resolve().parents[$parentIndex] / $pathExpr"
}
%>
