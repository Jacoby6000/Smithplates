<%
def snakeCase(name: String): String =
  name
    .replaceAll("([a-z0-9])([A-Z])", "$1_$2")
    .replaceAll("([A-Z]+)([A-Z][a-z])", "$1_$2")
    .toLowerCase

def unionVariantTypeName(unionName: String, memberName: String): String =
  s"$unionName${memberName.capitalize}"

def unionTypeAlias(unionName: String, memberNames: Seq[String]): String =
  memberNames.map(memberName => unionVariantTypeName(unionName, memberName)).mkString(" | ")

def operationMethodName(operationName: String): String =
  snakeCase(operationName)

def serviceModuleBaseName(serviceName: String): String =
  snakeCase(serviceName)

def serviceProtocolName(serviceName: String): String =
  s"${serviceName}ServiceProtocol"

def implementationClassName(serviceName: String, dialectKey: String): String =
  dialectKey match {
    case "sqlite"   => s"${serviceName}AiosqliteService"
    case "postgres" => s"${serviceName}PsycopgService"
    case other      => throw new IllegalArgumentException(s"unsupported dialect key: $other")
  }

def implementationModuleName(serviceName: String, dialectKey: String): String =
  s"${serviceModuleBaseName(serviceName)}${implementationModuleSuffix(dialectKey)}"

def implementationModuleSuffix(dialectKey: String): String =
  dialectKey match {
    case "sqlite"   => "_aiosqlite"
    case "postgres" => "_psycopg"
    case other      => throw new IllegalArgumentException(s"unsupported dialect key: $other")
  }

def rowFactoryName(className: String): String =
  s"_${className}_row_factory"

def serviceFixtureName(serviceModuleBaseName: String): String =
  s"${serviceModuleBaseName}_service"

def rowTypeName(dialectKey: String): String =
  dialectKey match {
    case "sqlite"   => "tuple[object, ...] | sqlite3.Row"
    case "postgres" => "tuple[object, ...]"
    case other      => throw new IllegalArgumentException(s"unsupported dialect key: $other")
  }

def transactionTypeName(dialectKey: String): String =
  dialectKey match {
    case "sqlite"   => "aiosqlite.Connection"
    case "postgres" => "psycopg.AsyncTransaction"
    case other      => throw new IllegalArgumentException(s"unsupported dialect key: $other")
  }

def unionDiscriminatorKeys(union: com.jacoby6000.smithplates.sql.codegen.TemplateUnionView): String =
  com.jacoby6000.smithplates.sql.codegen.SqlCodegenHelperAttributes.unionDiscriminatorKeys(union)

def helperPartialPaths(ctx: com.jacoby6000.smithplates.sql.codegen.ServiceTemplateView): List[String] =
  com.jacoby6000.smithplates.sql.codegen.SqlCodegenHelperAttributes.helperPartialPaths(ctx)

def helperColPartialPaths(ctx: com.jacoby6000.smithplates.sql.codegen.ServiceTemplateView): List[String] =
  com.jacoby6000.smithplates.sql.codegen.SqlCodegenHelperAttributes.helperColPartialPaths(ctx)

def unionsUsedAsJson(ctx: com.jacoby6000.smithplates.sql.codegen.ServiceTemplateView): List[com.jacoby6000.smithplates.sql.codegen.TemplateUnionView] =
  com.jacoby6000.smithplates.sql.codegen.SqlCodegenHelperAttributes.unionsUsedAsJson(ctx)

def modelsUsedAsJson(ctx: com.jacoby6000.smithplates.sql.codegen.ServiceTemplateView): List[com.jacoby6000.smithplates.sql.codegen.TemplateModelView] =
  com.jacoby6000.smithplates.sql.codegen.SqlCodegenHelperAttributes.modelsUsedAsJson(ctx)

def unionsUsedAsJsonCol(ctx: com.jacoby6000.smithplates.sql.codegen.ServiceTemplateView): List[com.jacoby6000.smithplates.sql.codegen.TemplateUnionView] =
  com.jacoby6000.smithplates.sql.codegen.SqlCodegenHelperAttributes.unionsUsedAsJsonCol(ctx)

def modelsUsedAsJsonCol(ctx: com.jacoby6000.smithplates.sql.codegen.ServiceTemplateView): List[com.jacoby6000.smithplates.sql.codegen.TemplateModelView] =
  com.jacoby6000.smithplates.sql.codegen.SqlCodegenHelperAttributes.modelsUsedAsJsonCol(ctx)

def importRequirements(ctx: com.jacoby6000.smithplates.sql.codegen.ServiceTemplateView): com.jacoby6000.smithplates.sql.codegen.ImportRequirements =
  com.jacoby6000.smithplates.sql.codegen.SqlCodegenHelperAttributes.importRequirements(ctx)

def resultFieldAssignmentBindings(
    resultField: com.jacoby6000.smithplates.sql.codegen.TemplateResultFieldView,
    readMode: String,
    rowVar: String = "row"
): Map[String, Any] =
  Map(
    "fieldName"         -> resultField.fieldName,
    "typeName"          -> resultField.typeName,
    "isJson"            -> resultField.isJson,
    "readMode"          -> readMode,
    "columnIndex"       -> resultField.columnIndex,
    "columnNameLiteral" -> resultField.columnNameLiteral,
    "rowVar"            -> rowVar,
    "timestampFormat"   -> resultField.timestampFormat
  )

def pythonTypeName(typeName: String): String =
  if (typeName.startsWith("List[")) {
    val inner = typeName.substring(5, typeName.length - 1)
    s"list[${pythonTypeName(inner)}]"
  } else if (typeName.startsWith("Map[String, ")) {
    val inner = typeName.substring(12, typeName.length - 1)
    s"dict[str, ${pythonTypeName(inner)}]"
  } else {
    typeName match {
      case "String"                          => "str"
      case "Integer" | "Long" | "BigInteger" => "int"
      case "Float" | "Double"                => "float"
      case "BigDecimal"                      => "Decimal"
      case "Boolean"                         => "bool"
      case "Blob"                            => "bytes"
      case "Timestamp"                       => "datetime"
      case "Document"                        => "Any"
      case "Unit"                            => "None"
      case other                             => other
    }
  }
%>
