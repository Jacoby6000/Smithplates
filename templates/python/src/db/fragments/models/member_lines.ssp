<%@ val members: List[com.jacoby6000.smithplates.codegen.core.Field] %>
<%@ val ctx: com.jacoby6000.smithplates.sql.service.renderer.SqlNeutralServiceTemplateAttributes.ServiceView %>
#for (member <- members)
    ${member.name}: <% render("fragments/types/type_annotation", Map("typeName" -> sqlAttrs.memberTypeName(ctx, member), "optional" -> sqlAttrs.memberOptional(member))) +%>
#end
