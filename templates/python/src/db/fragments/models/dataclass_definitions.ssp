<%@ val models: List[com.jacoby6000.smithplates.sql.codegen.TemplateModelView] %>
<% for (model <- models) { %>@dataclass
class ${model.name}:
<% if (model.hasMembers) { %>
<% render("fragments/models/member_lines", Map("members" -> model.members)) +%><% } %>
<% if (!model.hasMembers) { %>
    pass
<% } %>

<% } %>
