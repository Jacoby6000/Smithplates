<%@ val ctx: com.jacoby6000.smithplates.sql.service.renderer.ServiceTemplateView %>
<%@ val test: com.jacoby6000.smithplates.sql.service.renderer.IntegrationTestView = ctx.integrationTest.get %>
from __future__ import annotations

from collections.abc import AsyncIterator
from pathlib import Path
<% if (test.extraImports != "") { %>${test.extraImports}<% } %>

import aiosqlite
import pytest
import pytest_asyncio
<% if (test.localImportBlock != "") { %>
${test.localImportBlock}
<% } %>
from ${qualifiedModule(ctx.packageName, migrationServiceModulePath(ctx.dialectKey))} import ${migrationServiceClassName(ctx.dialectKey)}

MIGRATIONS_DIRECTORY = ${migrationsDirectoryFromTestFile(ctx.serviceShapeId, configuredMigrationsDirectory(ctx))}


@pytest_asyncio.fixture
async def ${serviceFixtureName(ctx.serviceModuleName)}() -> AsyncIterator[${implementationClassName(ctx.serviceName, ctx.dialectKey)}]:
    connection = await aiosqlite.connect(":memory:")
    migration_service = SqliteMigrationService(connection, migrations_directory=MIGRATIONS_DIRECTORY)
    await migration_service.migrate_all()
<% for (statement <- test.setupSqlStatements) { %>
    await connection.execute("""${statement}""")
<% } %>
    await connection.commit()
    try:
        yield ${implementationClassName(ctx.serviceName, ctx.dialectKey)}(connection)
    finally:
        await connection.close()


@pytest.mark.integration
@pytest.mark.sqlite
@pytest.mark.asyncio
async def test_derived_sql_methods_lifecycle(${serviceFixtureName(ctx.serviceModuleName)}: ${implementationClassName(ctx.serviceName, ctx.dialectKey)}) -> None:
    entity_id_result = await ${serviceFixtureName(ctx.serviceModuleName)}.${operationMethodName(test.insertOperation.name)}(${test.insertOperation.callArguments})
    entity_id = entity_id_result${test.insertOperation.outputValueAccessor}
    assert isinstance(entity_id, str)
    assert entity_id

    fetched = await ${serviceFixtureName(ctx.serviceModuleName)}.${operationMethodName(test.selectOneOperation.name)}(${test.selectOneOperation.callArguments})
    assert isinstance(fetched, ${test.selectOneOperation.outputShapeName})
<% if (test.selectOneOperation.hasResultAssertions) { %>
<% for (assertion <- test.selectOneOperation.resultAssertions) { %>
    ${assertion.line}
<% } %>
<% } %>
<% if (test.hasUpdateOperation) { %>
<% include("fragments/tests/update_lifecycle") %>
<% } %>
<% if (test.hasDeleteOperation) { %>
<% include("fragments/tests/delete_lifecycle") %>
<% } %>
<% include("sqlite/tests/transaction_tests") %>
