<%@ val ctx: com.jacoby6000.smithplates.sql.service.codegen.ServiceTemplateView %>
<%@ val imports: com.jacoby6000.smithplates.sql.service.codegen.ImportRequirements = importRequirements(ctx) %>
from __future__ import annotations

<% render("fragments/helpers/imports_sqlite", Map("ctx" -> ctx)) +%>from typing import <% if (imports.needsCastImport) { %>cast, <% } %>override

import aiosqlite
<% if (ctx.serviceLocalImportBlock != "") { %>
${ctx.serviceLocalImportBlock}<% } %>


class ${implementationClassName(ctx.serviceName, ctx.dialectKey)}(${serviceProtocolName(ctx.serviceName)}[${transactionTypeName(ctx.dialectKey)}]):
    def __init__(self, connection: aiosqlite.Connection) -> None:
        super().__init__()
        self._connection = connection

<% for (operation <- ctx.operations) { %><% if (operation.hasSql) { %>
    @override
    async def ${operationMethodName(operation.name)}(
        self,
<% for (parameter <- operation.parameters) { %>
        ${parameter.name}: <% render("fragments/types/parameter_annotation", Map("typeName" -> parameter.typeName, "optional" -> parameter.optional)) %>,
<% } %>
<% render("fragments/types/transaction_parameter_impl", Map("dialectKey" -> ctx.dialectKey)) %><%= "\n" %>    ) -> <% render("fragments/types/response_type", Map("operation" -> operation)) +%>:
        async def execute(conn: aiosqlite.Connection) -> <% render("fragments/types/response_type", Map("operation" -> operation)) +%>:
<% render("fragments/operations/sqlite_operation_body", Map("operation" -> operation)) +%>        return await run(self._connection, transaction, execute)
<% } %><% } %>

<% include("fragments/helpers/row_reader_helpers") +%>
