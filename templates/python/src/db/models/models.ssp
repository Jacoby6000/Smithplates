<%@ val ctx: com.jacoby6000.smithplates.sql.service.renderer.SqlNeutralServiceTemplateAttributes.ServiceView %>
<%
def modelUsesType(typeName: String): Boolean = {
  val fieldTypes = sqlAttrs.models(ctx).flatMap(_.fields.map(member => sqlAttrs.renderType(ctx, member.tpe))) ++
    sqlAttrs.unions(ctx).flatMap(_.members.map(member => sqlAttrs.renderType(ctx, member.tpe)))
  fieldTypes.exists(_.split("[\\[\\], |]+").contains(typeName))
}
val needsDatetimeImport = modelUsesType("datetime")
val needsDecimalImport = modelUsesType("Decimal")
%>
from __future__ import annotations

from dataclasses import dataclass
<% if (needsDatetimeImport) { %>from datetime import datetime
<% } %><% if (needsDecimalImport) { %>from decimal import Decimal
<% } %><% if (enumImportBlock(ctx) != "") { %>${enumImportBlock(ctx)}<% } %><% if (customUuidTypeNames(ctx).nonEmpty) { %>
<% for (uuidTypeName <- customUuidTypeNames(ctx).toList.sorted) { %>
${uuidTypeName} = str
<% } %>
<% } %><% if (sqlAttrs.unions(ctx).nonEmpty) { %>


<% } else if (sqlAttrs.models(ctx).nonEmpty) { %>


<% } %><% for (union <- sqlAttrs.unions(ctx)) { %><% for (member <- union.members) { %>
@dataclass
class ${unionVariantTypeName(union.id.name, member.name)}:
    ${member.name}: <% render("fragments/types/type_name", Map("typeName" -> sqlAttrs.renderType(ctx, member.tpe))) +%>

<% } %>${union.id.name} = ${unionTypeAlias(union.id.name, union.members.map(_.name))}


<% } %><% render("fragments/models/dataclass_definitions", Map("models" -> sqlAttrs.models(ctx), "ctx" -> ctx)) %>
