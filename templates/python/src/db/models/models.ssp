<%@ val ctx: com.jacoby6000.smithplates.sql.service.renderer.ServiceTemplateView %>
<%@ val needsDatetimeImport: Boolean = ctx.models.exists(_.members.exists(_.typeName == "Timestamp")) || ctx.unions.exists(_.members.exists(_.typeName == "Timestamp")) %>
from __future__ import annotations

from typing import TypedDict
<% if (needsDatetimeImport) { %>from datetime import datetime
<% } %><% if (ctx.enumImportBlock != "") { %>${ctx.enumImportBlock}<% } %><% if (ctx.uuidTypeNames.nonEmpty) { %>
<% for (uuidTypeName <- ctx.uuidTypeNames) { %>
${uuidTypeName} = str
<% } %>
<% } %><% if (ctx.unions.nonEmpty || ctx.models.nonEmpty) { %>


<% } %><% for (union <- ctx.unions) { %><% for (member <- union.members) { %>
class ${unionVariantTypeName(union.name, member.name)}(TypedDict):
    ${member.name}: <% render("fragments/types/type_name", Map("typeName" -> member.typeName)) +%>

<% } %>${union.name} = ${unionTypeAlias(union.name, union.members.map(_.name))}


<% } %><% render("fragments/models/typeddict_definitions", Map("models" -> ctx.models)) %>
