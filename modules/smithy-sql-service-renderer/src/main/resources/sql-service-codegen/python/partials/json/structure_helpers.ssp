def _json_bind_${attrs("className")}(value: ${attrs("className")}) -> str:
    payload = { <% for (member <- attrs("members").asInstanceOf[List[Map[String, Any]]]) { %>"${member("name")}": cast(object, getattr(value, "${member("name")}"))<% if (!member("last").asInstanceOf[Boolean]) { %>, <% } %><% } %>${attrs("dictClose")}
    return json.dumps(payload)


def _read_${attrs("className")}(row: ${attrs("rowTypeName")}, index: int) -> ${attrs("className")}:
<% if (attrs.get("isSqliteDialect").exists(isTruthy)) { %><% include("partials/json/row_data_sqlite") %><% } %><% if (!attrs.get("isSqliteDialect").exists(isTruthy)) { %><% include("partials/json/row_data_postgres") %><% } %>
    return ${attrs("className")}(
<% for (member <- attrs("members").asInstanceOf[List[Map[String, Any]]]) { %>${attrs("i8")}${member("name")}=cast(${member("languageTypeName")}, data["${member("name")}"]),${"\n"}<% } %>${attrs("i4")})
