<% } %>
<% for (jsonStructureColSqlite <- attrs("jsonStructuresColSqlite").asInstanceOf[List[Map[String, Any]]]) { %>
<% render("partials/json/structure_helpers_col_sqlite", Map("attrs" -> (attrs ++ jsonStructureColSqlite.asInstanceOf[Map[String, Any]]))) +%>
<% } %>
