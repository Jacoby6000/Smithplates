<% if (attrs.get("isSqliteDialect").exists(isTruthy)) { %>
<% for (sqliteClassRowFactory <- attrs("sqliteClassRowFactories").asInstanceOf[List[Map[String, Any]]]) { %>
<% render("partials/row_factories/sqlite_class_row_factory", Map("attrs" -> (attrs ++ sqliteClassRowFactory.asInstanceOf[Map[String, Any]]))) +%>
<% } %>
<% if (attrs.get("usesSqliteNamedRowMapper").exists(isTruthy)) { %>
<% include("partials/row_mappers/sqlite_named_row") +%>
<% } %>
<% } %>
<% if (attrs.get("usesReadBool").exists(isTruthy)) { %>
<% include("partials/row_readers/read_bool") +%>
<% } %>
<% if (attrs.get("usesReadBytes").exists(isTruthy)) { %>
<% include("partials/row_readers/read_bytes") +%>
<% } %>
<% if (attrs.get("usesReadDatetime").exists(isTruthy)) { %>
<% if (attrs.get("isSqliteDialect").exists(isTruthy)) { %>
<% include("partials/row_readers/read_datetime_sqlite") +%>
<% } %>
<% if (!attrs.get("isSqliteDialect").exists(isTruthy)) { %>
<% include("partials/row_readers/read_datetime_postgres") +%>
<% } %>
<% } %>
<% if (attrs.get("usesReadDecimal").exists(isTruthy)) { %>
<% include("partials/row_readers/read_decimal") +%>
<% } %>
<% if (attrs.get("usesReadEpochSeconds").exists(isTruthy)) { %>
<% if (attrs.get("isSqliteDialect").exists(isTruthy)) { %>
<% include("partials/row_readers/read_epoch_seconds_sqlite") +%>
<% } %>
<% if (!attrs.get("isSqliteDialect").exists(isTruthy)) { %>
<% include("partials/row_readers/read_epoch_seconds_postgres") +%>
<% } %>
<% } %>
<% if (attrs.get("usesReadFloat").exists(isTruthy)) { %>
<% include("partials/row_readers/read_float") +%>
<% } %>
<% if (attrs.get("usesReadInt").exists(isTruthy)) { %>
<% include("partials/row_readers/read_int") +%>
<% } %>
<% if (attrs.get("usesReadStr").exists(isTruthy)) { %>
<% if (attrs.get("isPostgresDialect").exists(isTruthy)) { %>
<% include("partials/row_readers/read_str_postgres") +%>
<% } %>
<% if (!attrs.get("isPostgresDialect").exists(isTruthy)) { %>
<% include("partials/row_readers/read_str_sqlite") +%>
<% } %>
<% } %>
<% if (attrs.get("usesTimestampBindDatetime").exists(isTruthy)) { %>
<% include("partials/timestamps/bind_datetime") +%>
<% } %>
<% if (attrs.get("usesTimestampBindEpochSeconds").exists(isTruthy)) { %>
<% if (attrs.get("isSqliteDialect").exists(isTruthy)) { %>
<% include("partials/timestamps/bind_epoch_seconds_sqlite") +%>
<% } %>
<% if (!attrs.get("isSqliteDialect").exists(isTruthy)) { %>
<% include("partials/timestamps/bind_epoch_seconds_postgres") +%>
<% } %>
<% } %>
<% for (jsonUnion <- attrs("jsonUnions").asInstanceOf[List[Map[String, Any]]]) { %>
<% render("partials/json/union_helpers", Map("attrs" -> (attrs ++ jsonUnion.asInstanceOf[Map[String, Any]]))) +%>
<% } %>
<% for (jsonStructure <- attrs("jsonStructures").asInstanceOf[List[Map[String, Any]]]) { %>
<% render("partials/json/structure_helpers", Map("attrs" -> (attrs ++ jsonStructure.asInstanceOf[Map[String, Any]]))) +%>
<% } %>
<% if (attrs.get("usesReadBoolCol").exists(isTruthy)) { %>
<% include("partials/row_readers/read_bool_col") +%>
<% } %>
<% if (attrs.get("usesReadBytesCol").exists(isTruthy)) { %>
<% include("partials/row_readers/read_bytes_col") +%>
<% } %>
<% if (attrs.get("usesReadDatetimeCol").exists(isTruthy)) { %>
<% if (attrs.get("isSqliteDialect").exists(isTruthy)) { %>
<% include("partials/row_readers/read_datetime_sqlite_col") +%>
<% } %>
<% if (!attrs.get("isSqliteDialect").exists(isTruthy)) { %>
<% include("partials/row_readers/read_datetime_postgres_col") +%>
<% } %>
<% } %>
<% if (attrs.get("usesReadDecimalCol").exists(isTruthy)) { %>
<% include("partials/row_readers/read_decimal_col") +%>
<% } %>
<% if (attrs.get("usesReadEpochSecondsCol").exists(isTruthy)) { %>
<% include("partials/row_readers/read_epoch_seconds_postgres_col") +%>
<% } %>
<% if (attrs.get("usesReadFloatCol").exists(isTruthy)) { %>
<% include("partials/row_readers/read_float_col") +%>
<% } %>
<% if (attrs.get("usesReadIntCol").exists(isTruthy)) { %>
<% include("partials/row_readers/read_int_col") +%>
<% } %>
<% if (attrs.get("usesReadStrCol").exists(isTruthy)) { %>
<% if (attrs.get("isSqliteDialect").exists(isTruthy)) { %>
<% include("partials/row_readers/read_str_sqlite_col") +%>
<% } %>
<% if (!attrs.get("isSqliteDialect").exists(isTruthy)) { %>
<% include("partials/row_readers/read_str_postgres_col") +%>
<% } %>
<% } %>
<% for (jsonUnionColPostgres <- attrs("jsonUnionsColPostgres").asInstanceOf[List[Map[String, Any]]]) { %>
<% render("partials/json/union_helpers_col", Map("attrs" -> (attrs ++ jsonUnionColPostgres.asInstanceOf[Map[String, Any]]))) +%>
<% } %>
<% for (jsonStructureColPostgres <- attrs("jsonStructuresColPostgres").asInstanceOf[List[Map[String, Any]]]) { %>
