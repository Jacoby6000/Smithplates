<% for (member <- attrs("members").asInstanceOf[List[Map[String, Any]]]) { %>${attrs("i4")}${member("name")}: <% if (member("optional").asInstanceOf[Boolean]) { %>${member("languageTypeName")} | None<% } %><% if (!member("optional").asInstanceOf[Boolean]) { %>${member("languageTypeName")}<% } %>${"\n"}<% } %>
