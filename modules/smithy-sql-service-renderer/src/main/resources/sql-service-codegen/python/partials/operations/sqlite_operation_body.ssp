<% if (attrs.get("isInsertScalar").exists(isTruthy)) { %>
<% render("partials/sql/sqlite_cursor_execute", Map("attrs" -> attrs)) %>
            row = await cursor.fetchone()
            if row is None:
                raise RuntimeError("INSERT RETURNING produced no row")
            return _read_str(row, ${attrs("returningColumnIndex")})
<% } %><% if (attrs.get("isInsertStructure").exists(isTruthy)) { %><% if (attrs.get("usesDictRowFactory").exists(isTruthy)) { %>
<% render("partials/sql/sqlite_cursor_execute", Map("attrs" -> attrs)) %>
            row = await cursor.fetchone()
            if row is None:
                raise RuntimeError("INSERT RETURNING produced no row")
            <% render("partials/sql/sqlite_named_row_mapper", Map("attrs" -> attrs)) %>
            return ${attrs("outputShapeName")}(
<% for (resultField <- attrs("resultFields").asInstanceOf[List[Map[String, Any]]]) { %>                <% render("partials/sql/result_field_assignment", resultFieldAssignmentAttrs(resultField.asInstanceOf[Map[String, Any]], "col", "named_row")) %><% } %>
            )
<% } %><% if (!attrs.get("usesDictRowFactory").exists(isTruthy)) { %>
<% render("partials/sql/sqlite_cursor_execute", Map("attrs" -> attrs)) %>
            row = await cursor.fetchone()
            if row is None:
                raise RuntimeError("INSERT RETURNING produced no row")
            return ${attrs("outputShapeName")}(
<% for (resultField <- attrs("resultFields").asInstanceOf[List[Map[String, Any]]]) { %>                <% render("partials/sql/result_field_assignment", resultFieldAssignmentAttrs(resultField.asInstanceOf[Map[String, Any]], "index")) %><% } %>
            )
<% } %><% } %><% if (attrs.get("isBooleanMutation").exists(isTruthy)) { %>
<% render("partials/sql/sqlite_cursor_execute", Map("attrs" -> attrs)) %><% if (attrs.get("isRowcountExecution").exists(isTruthy)) { %>
            return cursor.rowcount > 0
<% } %><% if (!attrs.get("isRowcountExecution").exists(isTruthy)) { %>
            row = await cursor.fetchone()
            return row is not None
<% } %><% } %><% if (attrs.get("isSelectOne").exists(isTruthy)) { %><% if (attrs.get("canUseClassRow").exists(isTruthy)) { %>
<% render("partials/sql/sqlite_cursor_execute", Map("attrs" -> attrs)) %>
            row = await cursor.fetchone()
            if row is None:
                return None
            return ${rowFactoryName(attrs("outputShapeName").asInstanceOf[String])}(cursor, row)
<% } %><% if (!attrs.get("canUseClassRow").exists(isTruthy)) { %><% if (attrs.get("usesDictRowFactory").exists(isTruthy)) { %>
<% render("partials/sql/sqlite_cursor_execute", Map("attrs" -> attrs)) %>
            row = await cursor.fetchone()
            if row is None:
                return None
            <% render("partials/sql/sqlite_named_row_mapper", Map("attrs" -> attrs)) %>
            return ${attrs("outputShapeName")}(
<% for (resultField <- attrs("resultFields").asInstanceOf[List[Map[String, Any]]]) { %>                <% render("partials/sql/result_field_assignment", resultFieldAssignmentAttrs(resultField.asInstanceOf[Map[String, Any]], "col", "named_row")) %><% } %>
            )
<% } %><% if (!attrs.get("usesDictRowFactory").exists(isTruthy)) { %>
<% render("partials/sql/sqlite_cursor_execute", Map("attrs" -> attrs)) %>
            row = await cursor.fetchone()
            if row is None:
                return None
            return ${attrs("outputShapeName")}(
<% for (resultField <- attrs("resultFields").asInstanceOf[List[Map[String, Any]]]) { %>                <% render("partials/sql/result_field_assignment", resultFieldAssignmentAttrs(resultField.asInstanceOf[Map[String, Any]], "index")) %><% } %>
            )
<% } %><% } %><% } %>