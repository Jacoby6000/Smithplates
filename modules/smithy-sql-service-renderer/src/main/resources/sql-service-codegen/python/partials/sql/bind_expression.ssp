<% if (attrs.get("isJson").exists(isTruthy)) { %>_json_bind_${attrs("jsonTypeName")}(${attrs("memberName")})<% } else if (attrs("typeName") == "Timestamp" && attrs.get("timestampFormat").exists(_ != null)) { %><% if (attrs("timestampFormat") == "DateTime" && attrs("dialectKey") == "sqlite") { %>_timestamp_bind_datetime(${attrs("memberName")})<% } else if (attrs("timestampFormat") == "EpochSeconds") { %>_timestamp_bind_epoch_seconds(${attrs("memberName")})<% } else { %>${attrs("memberName")}<% } %><% } else { %>${attrs("memberName")}<% } %>