<% for (bindParameter <- attrs("bindParameters").asInstanceOf[List[Map[String, Any]]]) { %><% if (bindParameter("only").asInstanceOf[Boolean]) { %>(${bindParameter("bindExpression")},)<% } %><% if (!bindParameter("only").asInstanceOf[Boolean]) { %><% if (bindParameter("first").asInstanceOf[Boolean]) { %>(<% } %>${bindParameter("bindExpression")}<% if (!bindParameter("last").asInstanceOf[Boolean]) { %>, <% } %><% if (bindParameter("last").asInstanceOf[Boolean]) { %>)<% } %><% } %><% } %>
