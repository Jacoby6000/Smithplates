<% for (bindParameter <- attrs("bindParameters").asInstanceOf[List[Map[String, Any]]]) { %><% if (bindParameter("only").asInstanceOf[Boolean]) { %>(<% render("partials/python/bind_expression", Map("attrs" -> (attrs ++ bindParameter.asInstanceOf[Map[String, Any]]))) %>,)<% } %><% if (!bindParameter("only").asInstanceOf[Boolean]) { %><% if (bindParameter("first").asInstanceOf[Boolean]) { %>(<% } %><% render("partials/python/bind_expression", Map("attrs" -> (attrs ++ bindParameter.asInstanceOf[Map[String, Any]]))) %><% if (!bindParameter("last").asInstanceOf[Boolean]) { %>, <% } %><% if (bindParameter("last").asInstanceOf[Boolean]) { %>)<% } %><% } %><% } %>