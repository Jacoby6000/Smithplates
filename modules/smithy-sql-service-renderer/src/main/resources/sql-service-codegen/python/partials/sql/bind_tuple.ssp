<%
  val bindParameters = attrs("bindParameters").asInstanceOf[List[Map[String, Any]]]
  val renderedParams = bindParameters.map { bindParameter =>
    capture {
      render("partials/sql/bind_expression", bindParameter.asInstanceOf[Map[String, Any]])
    }
  }
%>
(${renderedParams.mkString(", ")}${if (bindParameters.length == 1) "," else ""})