<% if (attrs.get("isInsertScalar").exists(isTruthy)) { %>
            cur = await self._connection.execute(
                """${attrs("sqlStatement")}""",
                <% render("partials/sql/bind_tuple", Map("attrs" -> attrs)) %>,
            )
            row = await cur.fetchone()
            if row is None:
                raise RuntimeError("INSERT RETURNING produced no row")
            return _read_str(row, ${attrs("returningColumnIndex")})
<% } %><% if (attrs.get("isInsertStructure").exists(isTruthy)) { %><% if (attrs.get("usesDictRowFactory").exists(isTruthy)) { %>
<% layout("partials/sql/postgres_cursor_wrapper", Map("rowFactoryExpr" -> "dict_row", "typeIgnoreComment" -> "  # type: ignore[misc]")) { %>
<% render("partials/sql/postgres_cursor_execute", Map("attrs" -> attrs)) %>
                row = await cur.fetchone()
                if row is None:
                    raise RuntimeError("INSERT RETURNING produced no row")
                return ${attrs("outputShapeName")}(
<% for (resultField <- attrs("resultFields").asInstanceOf[List[Map[String, Any]]]) { %>                    <% render("partials/sql/result_field_assignment", resultFieldAssignmentAttrs(resultField.asInstanceOf[Map[String, Any]], "col")) %><% } %>
                )
<% } %><% } %><% if (!attrs.get("usesDictRowFactory").exists(isTruthy)) { %>
            cur = await self._connection.execute(
                """${attrs("sqlStatement")}""",
                <% render("partials/sql/bind_tuple", Map("attrs" -> attrs)) %>,
            )
            row = await cur.fetchone()
            if row is None:
                raise RuntimeError("INSERT RETURNING produced no row")
            return ${attrs("outputShapeName")}(
<% for (resultField <- attrs("resultFields").asInstanceOf[List[Map[String, Any]]]) { %>                <% render("partials/sql/result_field_assignment", resultFieldAssignmentAttrs(resultField.asInstanceOf[Map[String, Any]], "index")) %><% } %>
            )
<% } %><% } %><% if (attrs.get("isBooleanMutation").exists(isTruthy)) { %><% if (!attrs.get("isRowcountExecution").exists(isTruthy)) { %>
            cur = await self._connection.execute(
                """${attrs("sqlStatement")}""",
                <% render("partials/sql/bind_tuple", Map("attrs" -> attrs)) %>,
            )
            row = await cur.fetchone()
            return row is not None
<% } %><% if (attrs.get("isRowcountExecution").exists(isTruthy)) { %>
            cur = await self._connection.execute(
                """${attrs("sqlStatement")}""",
                <% render("partials/sql/bind_tuple", Map("attrs" -> attrs)) %>,
            )
            return cur.rowcount > 0
<% } %><% } %><% if (attrs.get("isSelectOne").exists(isTruthy)) { %><% if (attrs.get("canUseClassRow").exists(isTruthy)) { %>
<% layout("partials/sql/postgres_cursor_wrapper", Map("rowFactoryExpr" -> s"class_row(${attrs("outputShapeName")})")) { %>
<% render("partials/sql/postgres_cursor_execute", Map("attrs" -> attrs)) %>
                return await cur.fetchone()
<% } %><% } %><% if (!attrs.get("canUseClassRow").exists(isTruthy)) { %><% if (attrs.get("usesDictRowFactory").exists(isTruthy)) { %>
<% layout("partials/sql/postgres_cursor_wrapper", Map("rowFactoryExpr" -> "dict_row", "typeIgnoreComment" -> "  # type: ignore[misc]")) { %>
<% render("partials/sql/postgres_cursor_execute", Map("attrs" -> attrs)) %>
                row = await cur.fetchone()
                if row is None:
                    return None
                return ${attrs("outputShapeName")}(
<% for (resultField <- attrs("resultFields").asInstanceOf[List[Map[String, Any]]]) { %>                    <% render("partials/sql/result_field_assignment", resultFieldAssignmentAttrs(resultField.asInstanceOf[Map[String, Any]], "col")) %><% } %>
                )
<% } %><% } %><% if (!attrs.get("usesDictRowFactory").exists(isTruthy)) { %>
            cur = await self._connection.execute(
                """${attrs("sqlStatement")}""",
                <% render("partials/sql/bind_tuple", Map("attrs" -> attrs)) %>,
            )
            row = await cur.fetchone()
            if row is None:
                return None
            return ${attrs("outputShapeName")}(
<% for (resultField <- attrs("resultFields").asInstanceOf[List[Map[String, Any]]]) { %>                <% render("partials/sql/result_field_assignment", resultFieldAssignmentAttrs(resultField.asInstanceOf[Map[String, Any]], "index")) %><% } %>
            )
<% } %><% } %><% } %>