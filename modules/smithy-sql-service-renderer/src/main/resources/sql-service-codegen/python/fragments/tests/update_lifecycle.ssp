
    updated = await ${serviceFixtureName(serviceModuleBaseName(attrs("serviceName").asInstanceOf[String]))}.${operationMethodName(attrs("updateOperation.name").asInstanceOf[String])}(${attrs("updateOperation.callArguments")})
    assert updated is True

    fetched_after_update = await ${serviceFixtureName(serviceModuleBaseName(attrs("serviceName").asInstanceOf[String]))}.${operationMethodName(attrs("selectOneOperation.name").asInstanceOf[String])}(${attrs("selectOneOperation.callArguments")})
    assert isinstance(fetched_after_update, ${attrs("selectOneOperation.outputShapeName")})
<% if (attrs.get("selectOneOperation").exists(isTruthy)) { val selectOneOperation = attrs("selectOneOperation").asInstanceOf[Map[String, Any]] %>
<% if (selectOneOperation.get("hasUpdatedResultAssertions").exists(isTruthy)) { %>
<% for (assertion <- selectOneOperation("updatedResultAssertions").asInstanceOf[List[Map[String, Any]]]) { %>
    ${assertion("line")}
<% } %>
<% } %>
<% } %>
