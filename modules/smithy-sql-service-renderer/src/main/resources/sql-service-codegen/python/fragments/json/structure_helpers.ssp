def _json_bind_${attrs("name")}(value: ${attrs("name")}) -> str:
    payload = { <% for (member <- attrs("members").asInstanceOf[List[Map[String, Any]]]) { %>"${member("name")}": cast(object, getattr(value, "${member("name")}"))<% if (!member("last").asInstanceOf[Boolean]) { %>, <% } %><% } %>${attrs("dictClose")}
    return json.dumps(payload)


def _read_${attrs("name")}(row: ${rowTypeName(attrs("dialectKey").asInstanceOf[String])}, index: int) -> ${attrs("name")}:
<% if (attrs.get("isSqliteDialect").exists(isTruthy)) { %>
<% include("fragments/json/row_data_sqlite") %>
<% } %>
<% if (!attrs.get("isSqliteDialect").exists(isTruthy)) { %>
<% include("fragments/json/row_data_postgres") %>
<% } %>
    return ${attrs("name")}(
<% for (member <- attrs("members").asInstanceOf[List[Map[String, Any]]]) { %>
        ${member("name")}=cast(<% render("fragments/types/type_name", Map("typeName" -> member("typeName"))) %>, data["${member("name")}"]),
<% } %>    )
