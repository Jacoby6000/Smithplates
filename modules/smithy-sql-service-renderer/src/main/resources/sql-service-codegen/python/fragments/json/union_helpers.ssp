def _json_bind_${attrs("name")}(value: ${attrs("name")}) -> str:
    present = [key for key in (${attrs("discriminatorKeys")}) if key in value]
    if len(present) != 1:
        raise ValueError("${attrs("name")} union value must contain exactly one member key")
    return json.dumps(cast(object, value))


def _read_${attrs("name")}(row: ${rowTypeName(attrs("dialectKey").asInstanceOf[String])}, index: int) -> ${attrs("name")}:
<% if (attrs.get("isSqliteDialect").exists(isTruthy)) { %>
<% include("partials/json/row_data_sqlite") %>
<% } %>
<% if (!attrs.get("isSqliteDialect").exists(isTruthy)) { %>
<% include("partials/json/row_data_postgres") %>
<% } %>
    present = [key for key in (${attrs("discriminatorKeys")}) if key in data]
    if len(present) != 1:
        raise ValueError(f"unknown ${attrs("name")} discriminator: {sorted(data.keys())}")
    return cast(${attrs("name")}, data)
