#match (attrs("sqlBodyKind"))
#case ("insertScalar")            cur = await self._connection.execute(
                """${attrs("sqlStatement")}""",
                <% render("fragments/sql/bind_tuple", Map("attrs" -> attrs)) %>,
            )
            row = await cur.fetchone()
            if row is None:
                raise RuntimeError("INSERT RETURNING produced no row")
            return _read_str(row, ${attrs("returningColumnIndex")})
#case ("insertStructureDict")<% layout("fragments/sql/postgres_cursor_wrapper", Map("rowFactoryExpr" -> "dict_row", "typeIgnoreComment" -> "  # type: ignore[misc]")) { %>
<% render("fragments/sql/postgres_cursor_execute", Map("attrs" -> attrs)) %>
                row = await cur.fetchone()
                if row is None:
                    raise RuntimeError("INSERT RETURNING produced no row")
                return ${attrs("outputShapeName")}(
<% for (resultField <- attrs("resultFields").asInstanceOf[List[Map[String, Any]]]) { %>                    <% render("fragments/sql/result_field_assignment", resultFieldAssignmentAttrs(resultField.asInstanceOf[Map[String, Any]], "col")) %><% } %>
                )
<% } %>
#case ("insertStructureIndex")            cur = await self._connection.execute(
                """${attrs("sqlStatement")}""",
                <% render("fragments/sql/bind_tuple", Map("attrs" -> attrs)) %>,
            )
            row = await cur.fetchone()
            if row is None:
                raise RuntimeError("INSERT RETURNING produced no row")
            return ${attrs("outputShapeName")}(
<% for (resultField <- attrs("resultFields").asInstanceOf[List[Map[String, Any]]]) { %>                <% render("fragments/sql/result_field_assignment", resultFieldAssignmentAttrs(resultField.asInstanceOf[Map[String, Any]], "index")) %><% } %>
            )
#case ("booleanMutationExists")            cur = await self._connection.execute(
                """${attrs("sqlStatement")}""",
                <% render("fragments/sql/bind_tuple", Map("attrs" -> attrs)) %>,
            )
            row = await cur.fetchone()
            return row is not None
#case ("booleanMutationRowcount")            cur = await self._connection.execute(
                """${attrs("sqlStatement")}""",
                <% render("fragments/sql/bind_tuple", Map("attrs" -> attrs)) %>,
            )
            return cur.rowcount > 0
#case ("selectOneClassRow")<% layout("fragments/sql/postgres_cursor_wrapper", Map("rowFactoryExpr" -> s"class_row(${attrs("outputShapeName")})")) { %>
<% render("fragments/sql/postgres_cursor_execute", Map("attrs" -> attrs)) %>
                return await cur.fetchone()
<% } %>
#case ("selectOneDict")<% layout("fragments/sql/postgres_cursor_wrapper", Map("rowFactoryExpr" -> "dict_row", "typeIgnoreComment" -> "  # type: ignore[misc]")) { %>
<% render("fragments/sql/postgres_cursor_execute", Map("attrs" -> attrs)) %>
                row = await cur.fetchone()
                if row is None:
                    return None
                return ${attrs("outputShapeName")}(
<% for (resultField <- attrs("resultFields").asInstanceOf[List[Map[String, Any]]]) { %>                    <% render("fragments/sql/result_field_assignment", resultFieldAssignmentAttrs(resultField.asInstanceOf[Map[String, Any]], "col")) %><% } %>
                )
<% } %>
#case ("selectOneIndex")            cur = await self._connection.execute(
                """${attrs("sqlStatement")}""",
                <% render("fragments/sql/bind_tuple", Map("attrs" -> attrs)) %>,
            )
            row = await cur.fetchone()
            if row is None:
                return None
            return ${attrs("outputShapeName")}(
<% for (resultField <- attrs("resultFields").asInstanceOf[List[Map[String, Any]]]) { %>                <% render("fragments/sql/result_field_assignment", resultFieldAssignmentAttrs(resultField.asInstanceOf[Map[String, Any]], "index")) %><% } %>
            )
#end