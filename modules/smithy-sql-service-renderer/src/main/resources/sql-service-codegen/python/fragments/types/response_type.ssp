<%
def responseType(attrs: Map[String, Any]): String = {
  val isSelectOne = attrs.get("isSelectOne").exists {
    case value: Boolean => value
    case _              => false
  }
  val hasOutput = attrs.get("hasOutput").exists {
    case value: Boolean => value
    case _              => false
  }

  if (isSelectOne) {
    if (hasOutput) {
      s"${pythonTypeName(attrs("outputTypeName").toString)} | None"
    } else {
      "None"
    }
  } else {
    val responseTypes = scala.collection.mutable.ListBuffer.empty[String]
    if (hasOutput) {
      responseTypes += pythonTypeName(attrs("outputTypeName").toString)
    }
    attrs("errors").asInstanceOf[List[Map[String, Any]]].foreach { error =>
      responseTypes += error("name").toString
    }
    responseTypes.toList match {
      case Nil           => "None"
      case single :: Nil => single
      case many          => many.mkString(" | ")
    }
  }
}
%>${responseType(attrs)}