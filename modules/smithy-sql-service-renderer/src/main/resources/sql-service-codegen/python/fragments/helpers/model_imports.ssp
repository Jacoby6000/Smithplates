from ${serviceModuleBaseName(attrs("serviceName").asInstanceOf[String])}_models import (
<% for (model <- attrs("models").asInstanceOf[List[Map[String, Any]]]) { %>
    ${model("name")},
<% } %>
<% for (union <- attrs("unions").asInstanceOf[List[Map[String, Any]]]) { %>
    ${union("name")},
<% } %>
)
