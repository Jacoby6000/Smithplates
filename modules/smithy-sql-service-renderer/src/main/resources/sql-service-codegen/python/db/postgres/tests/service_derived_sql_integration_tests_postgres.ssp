async def _apply_schema_ddl(connection: psycopg.AsyncConnection, schema_ddl: str) -> None:
    for statement in schema_ddl.split(";"):
        ddl_statement = statement.strip()
        if ddl_statement:
            _ = await connection.execute(f"{ddl_statement};")


