
@pytest.mark.integration
@pytest.mark.postgres
@pytest.mark.asyncio
async def test_derived_sql_methods_transaction_commit(${serviceFixtureName(serviceModuleBaseName(attrs("serviceName").asInstanceOf[String]))}: ${implementationClassName(attrs("serviceName").asInstanceOf[String], attrs("dialectKey").asInstanceOf[String])}) -> None:
    connection = ${serviceFixtureName(serviceModuleBaseName(attrs("serviceName").asInstanceOf[String]))}._connection
    async with connection.transaction() as tx:
        entity_id = await ${serviceFixtureName(serviceModuleBaseName(attrs("serviceName").asInstanceOf[String]))}.${operationMethodName(attrs("insertOperation.name").asInstanceOf[String])}(${attrs("insertOperation.callArguments")}, transaction=tx)
        assert isinstance(entity_id, str)
        assert entity_id

        fetched = await ${serviceFixtureName(serviceModuleBaseName(attrs("serviceName").asInstanceOf[String]))}.${operationMethodName(attrs("selectOneOperation.name").asInstanceOf[String])}(${attrs("selectOneOperation.callArguments")}, transaction=tx)
        assert isinstance(fetched, ${attrs("selectOneOperation.outputShapeName")})
<% for (assertion <- attrs("transactionCommitInTxAssertions").asInstanceOf[List[Map[String, Any]]]) { %>
        ${assertion("line")}
<% } %>

    fetched_after_commit = await ${serviceFixtureName(serviceModuleBaseName(attrs("serviceName").asInstanceOf[String]))}.${operationMethodName(attrs("selectOneOperation.name").asInstanceOf[String])}(${attrs("selectOneOperation.callArguments")})
    assert isinstance(fetched_after_commit, ${attrs("selectOneOperation.outputShapeName")})
<% for (assertion <- attrs("transactionCommitAfterAssertions").asInstanceOf[List[Map[String, Any]]]) { %>
    ${assertion("line")}
<% } %>


