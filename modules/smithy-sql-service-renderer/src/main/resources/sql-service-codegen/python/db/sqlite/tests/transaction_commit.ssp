${"\n"}@pytest.mark.integration
@pytest.mark.sqlite
@pytest.mark.asyncio
async def test_derived_sql_methods_transaction_commit(${attrs("serviceFixtureName")}: ${attrs("implementationClassName")}) -> None:
${attrs("i4")}connection = ${attrs("serviceFixtureName")}._connection
${attrs("i4")}await connection.execute("BEGIN")
${attrs("i4")}try:
${attrs("i8")}entity_id = await ${attrs("serviceFixtureName")}.${attrs("insertOperation.methodName")}(${attrs("insertOperation.callArguments")}, transaction=connection)
${attrs("i8")}assert isinstance(entity_id, str)
${attrs("i8")}assert entity_id

${attrs("i8")}fetched = await ${attrs("serviceFixtureName")}.${attrs("selectOneOperation.methodName")}(${attrs("selectOneOperation.callArguments")}, transaction=connection)
${attrs("i8")}assert isinstance(fetched, ${attrs("selectOneOperation.outputClassName")})
<% for (assertion <- attrs("transactionCommitInTxAssertions").asInstanceOf[List[Map[String, Any]]]) { %>
${assertion("line")}
<% } %>
${attrs("i8")}await connection.commit()
${attrs("i4")}except BaseException:
${attrs("i8")}await connection.rollback()
${attrs("i8")}raise

${attrs("i4")}fetched_after_commit = await ${attrs("serviceFixtureName")}.${attrs("selectOneOperation.methodName")}(${attrs("selectOneOperation.callArguments")})
${attrs("i4")}assert isinstance(fetched_after_commit, ${attrs("selectOneOperation.outputClassName")})
<% for (assertion <- attrs("transactionCommitAfterAssertions").asInstanceOf[List[Map[String, Any]]]) { %>
${assertion("line")}
<% } %>
${"\n"}
