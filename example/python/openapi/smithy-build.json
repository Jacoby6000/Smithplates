{
  "version": "1.0",
  "sources": [
    "../smithy/common.smithy",
    "../smithy/api.smithy",
    "../smithy/http-service.smithy"
  ],
  "maven": {
    "dependencies": [
      "com.jacoby6000:smithplates-plugin:0.1.0",
      "software.amazon.smithy:smithy-aws-traits:1.71.0",
      "software.amazon.smithy:smithy-openapi:1.71.0"
    ]
  },
  "plugins": {},
