{
  "version": "1.0",
  "sources": ["../petstore-smithy-spec/petstore/api"],
  "maven": {
    "dependencies": [
      "com.jacoby6000:smithplates-plugin:${SMITHPLATES_VERSION}",
      "software.amazon.smithy:smithy-aws-traits:${SMITHY_VERSION}",
      "software.amazon.smithy:smithy-openapi:${SMITHY_VERSION}"
    ]
  },
  "plugins": {},
  "projections": {
    "openapi": {
      "transforms": [
        { "name": "applyHttpProblemHttpError" },
        { "name": "applyHttpServiceRestJson1" },
        { "name": "stripSmithplatesHttpCodegenTraits" }
      ],
      "plugins": {
        "openapi": {
          "service": "petstore.api#Petstore",
          "protocol": "aws.protocols#restJson1"
        }
      }
    }
  }
}
