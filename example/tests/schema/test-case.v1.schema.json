{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smithystache.dev/schemas/example-test-case/v1",
  "title": "Smithystache reference HTTP test case",
  "type": "object",
  "required": ["schema", "name", "steps"],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "smithystache.example.test-case/v1"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "variables": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/step"
      }
    }
  },
  "$defs": {
    "step": {
      "type": "object",
      "required": ["request", "expect"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "request": {
          "$ref": "#/$defs/request"
        },
        "expect": {
          "$ref": "#/$defs/expect"
        },
        "capture": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "request": {
      "type": "object",
      "required": ["operationId", "method", "path"],
      "additionalProperties": false,
      "properties": {
        "operationId": {
          "type": "string",
          "minLength": 1,
          "description": "Smithy/OpenAPI operation name (e.g. GetPet). Typed-client runners dispatch on this; raw-HTTP runners may ignore it in favor of method/path."
        },
        "method": {
          "type": "string",
          "enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS"]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "pathParameters": {
          "type": "object",
          "description": "Operation path parameters keyed by their OpenAPI name (e.g. petId).",
          "additionalProperties": {
            "type": "string"
          }
        },
        "headers": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "json": true,
        "body": {
          "type": "string"
        },
        "transport": {
          "type": "string",
          "enum": ["client", "raw"],
          "default": "client",
          "description": "Use `raw` to issue HTTP directly (for example redirect responses that typed clients may follow)."
        }
      }
    },
    "expect": {
      "type": "object",
      "required": ["status"],
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "integer"
        },
        "headers": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "json": true,
        "body": {
          "type": "string"
        }
      }
    }
  }
}
